<% locals.currentPage = 'fleet' %>
<%
  // Group the cross-statement "unreconciled" list by plate/tag so a vehicle
  // missing from the register shows once, however many statements it's on.
  const groups = {};
  (unreconciled || []).forEach(u => {
    const k = u.kind + ':' + u.ref;
    const g = groups[k] || (groups[k] = { kind: u.kind, ref: u.ref, label: u.label, hint: u.hint, ambiguous: false, trips: 0, total: 0, statements: [] });
    g.trips += u.trips; g.total = Math.round((g.total + u.total) * 100) / 100;
    g.ambiguous = g.ambiguous || u.ambiguous;
    if (!g.label && u.label) g.label = u.label;
    g.statements.push({ id: u.invoiceId, number: u.invoiceNumber, periodStart: u.periodStart, periodEnd: u.periodEnd });
  });
  const unrecGroups = Object.values(groups);
  const addVehicleHref = (g, back) => {
    const q = [];
    if (g.kind === 'tag') q.push('toll_tag=' + encodeURIComponent(g.ref)); else q.push('rego=' + encodeURIComponent(g.ref));
    if (g.label && !g.hint) q.push('asset_id=' + encodeURIComponent(g.label));
    q.push('return_to=' + encodeURIComponent(back));
    return '/fleet/new?' + q.join('&');
  };
  const statusPill = (inv) => {
    if (inv.status === 'applied') return ['Added to vehicles', 'bg-emerald-50 text-emerald-700 ring-1 ring-emerald-600/20'];
    if (inv.status === 'partial') return ['Partly added', 'bg-blue-50 text-blue-700 ring-1 ring-blue-600/20'];
    if (inv.counts.unmatched) return ['Needs a look', 'bg-amber-50 text-amber-800 ring-1 ring-amber-600/20'];
    return ['Ready to add', 'bg-gray-100 text-gray-600 ring-1 ring-gray-200'];
  };
  const range = (a, b) => (a ? formatDateShort(a) : '?') + ' – ' + (b ? formatDateShort(b) : '?');
%>

<%- include('../partials/page-header', { rail: true,
  eyebrow: 'Operations',
  title: 'Toll Invoices',
  subtitle: 'E-Toll statements · trips per vehicle · reconciliation',
  actions: [
    { label: 'Vehicles', href: '/fleet', style: 'secondary', icon: 'M3 13l1.5-5A2 2 0 016.43 6.5h11.14a2 2 0 011.93 1.5L21 13M5 13h14v5H5z' }
  ]
}) %>

<!-- Upload + KPIs -->
<div class="grid grid-cols-1 lg:grid-cols-5 gap-4 mb-5">
  <form method="POST" action="/fleet/tolls/upload" enctype="multipart/form-data" id="tollUploadForm"
        class="lg:col-span-3 bg-white border border-gray-200 rounded-xl shadow-sm p-4">
    <div class="flex items-center justify-between mb-2">
      <h2 class="text-xs font-bold text-gray-800 uppercase tracking-widest">Upload a statement</h2>
      <span class="text-[11px] text-gray-400">PDF · up to 25 MB each · up to 12 at once</span>
    </div>
    <label class="invoice-drop" id="tollDrop">
      <input type="file" name="invoice" id="tollFile" accept="application/pdf,.pdf" multiple class="invoice-drop-input">
      <div class="invoice-drop-body">
        <svg class="invoice-drop-ico w-7 h-7 text-gray-400 mb-1 mx-auto" fill="none" stroke="currentColor" stroke-width="1.7" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4 16v2a2 2 0 002 2h12a2 2 0 002-2v-2M7 10l5-5 5 5M12 5v12"/></svg>
        <p class="invoice-drop-lead text-sm font-medium text-gray-700"><strong>Drag &amp; drop</strong> E-Toll Statement / Tax Invoice PDFs — one, or a whole year of them at once.</p>
        <p class="invoice-drop-hint text-[11px] text-gray-500 mt-0.5">Each statement is read and filed by its period automatically. You check the matches before anything is added to a vehicle.</p>
      </div>
      <div class="invoice-drop-chosen" hidden>
        <svg class="w-5 h-5 text-emerald-600 flex-shrink-0 animate-pulse" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
        <span class="invoice-drop-name text-sm font-medium text-gray-800"></span>
        <span class="text-xs text-gray-500" data-reading-note>Reading the statement…</span>
      </div>
    </label>
    <p class="text-[11px] text-gray-400 mt-2">Statements are kept here, so a plate that isn't in the register yet can be added later and reconciled against the old statement.</p>
  </form>

  <div class="lg:col-span-2 grid grid-cols-2 gap-3">
    <div class="stat-card">
      <p class="stat-card-label">Tolls · 12 months</p>
      <p class="stat-card-value is-money is-info"><%= AUD(kpi.tolls12) %></p>
      <p class="stat-card-sub"><%= kpi.trips12 %> trip<%= kpi.trips12 === 1 ? '' : 's' %> on vehicles</p>
    </div>
    <div class="stat-card">
      <p class="stat-card-label">Fees · 12 months</p>
      <p class="stat-card-value is-money <%= kpi.fees12 > 0 ? 'is-warn' : 'is-muted' %>"><%= AUD(kpi.fees12) %></p>
      <p class="stat-card-sub">video matching · toll notices</p>
    </div>
    <div class="stat-card">
      <p class="stat-card-label">Statements</p>
      <p class="stat-card-value"><%= invoices.length %></p>
      <p class="stat-card-sub"><%= AUD(kpi.totalAll) %> added all-time</p>
    </div>
    <div class="stat-card">
      <p class="stat-card-label">To reconcile</p>
      <p class="stat-card-value <%= unrecGroups.length ? 'is-warn' : 'is-good' %>" data-unreconciled-count><%= unrecGroups.length %></p>
      <p class="stat-card-sub">plates / tags without a vehicle</p>
    </div>
  </div>
</div>

<% if (unrecGroups.length) { %>
<div class="bg-amber-50 border border-amber-200 rounded-xl p-4 mb-5" data-unreconciled>
  <div class="flex items-start gap-3">
    <svg class="w-5 h-5 text-amber-700 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
    <div class="flex-1 min-w-0">
      <p class="text-xs font-bold text-amber-800 uppercase tracking-widest">Not in the register yet</p>
      <p class="text-sm text-amber-900 mt-1">These plates and tags have trips on a statement but no vehicle to go to. Add the vehicle (rego or tag prefilled) and you'll land back on the statement, already matched.</p>
      <div class="mt-3 flex flex-wrap gap-2">
        <% unrecGroups.forEach(g => { const back = '/fleet/tolls?review=' + g.statements[0].id; %>
          <div class="inline-flex flex-wrap items-center gap-x-2 gap-y-1 bg-white ring-1 ring-amber-200 rounded-lg px-2.5 py-1.5 text-xs" data-unreconciled-item="<%= g.kind %>:<%= g.ref %>">
            <span class="inline-flex items-center px-1.5 py-0.5 rounded text-[9px] font-bold uppercase tracking-wide <%= g.kind === 'tag' ? 'bg-sky-50 text-sky-700' : 'bg-violet-50 text-violet-700' %>"><%= g.kind %></span>
            <span class="font-mono font-semibold text-gray-900"><%= g.ref %></span>
            <% if (g.label) { %><span class="text-gray-500">· <%= g.label %></span><% } %>
            <span class="text-gray-500"><%= g.trips %> trip<%= g.trips === 1 ? '' : 's' %> · <%= AUD(g.total) %> · <%= g.statements.length %> statement<%= g.statements.length === 1 ? '' : 's' %></span>
            <% if (g.ambiguous) { %>
              <a href="<%= back %>" class="text-amber-800 font-semibold hover:underline">Choose the vehicle →</a>
            <% } else { %>
              <a href="<%= addVehicleHref(g, back) %>" class="text-brand-700 font-semibold hover:underline">+ Add vehicle</a>
            <% } %>
            <a href="<%= back %>" class="text-gray-400 hover:text-gray-700" title="Open statement <%= g.statements[0].number %>">↗</a>
          </div>
        <% }) %>
      </div>
    </div>
  </div>
</div>
<% } %>

<!-- Statements -->
<div class="bg-white border border-gray-200 rounded-xl shadow-sm overflow-hidden">
  <div class="px-4 py-3 border-b border-gray-100 flex items-center justify-between">
    <h2 class="text-xs font-bold text-gray-800 uppercase tracking-widest">Statements</h2>
    <span class="text-xs text-gray-400"><%= invoices.length %> uploaded · newest period first</span>
  </div>
  <% if (!invoices.length) { %>
    <div class="px-6 py-10 text-center">
      <svg class="w-10 h-10 text-gray-300 mx-auto mb-2" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6M7 4h7l5 5v11a1 1 0 01-1 1H7a1 1 0 01-1-1V5a1 1 0 011-1z"/></svg>
      <p class="text-sm font-medium text-gray-700">No statements yet</p>
      <p class="text-xs text-gray-400 mt-1">Drop the first E-Toll statement above — the trips are read out per tag and plate, then you add them to the vehicles.</p>
    </div>
  <% } else { %>
  <div class="overflow-x-auto">
    <table class="w-full text-sm" data-toll-invoices>
      <thead>
        <tr class="border-b border-gray-200 text-left text-[10px] font-bold text-gray-400 uppercase tracking-widest">
          <th class="px-4 py-2.5">Statement period</th>
          <th class="px-3 py-2.5 hidden sm:table-cell">Year</th>
          <th class="px-3 py-2.5 hidden md:table-cell">Issued</th>
          <th class="px-3 py-2.5 text-right">Tolls</th>
          <th class="px-3 py-2.5 text-right hidden sm:table-cell">Fees</th>
          <th class="px-3 py-2.5 text-right">Total</th>
          <th class="px-3 py-2.5 hidden lg:table-cell">Vehicles</th>
          <th class="px-3 py-2.5">Status</th>
          <th class="px-3 py-2.5"></th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-100">
        <% invoices.forEach(inv => { const c = inv.counts; const pill = statusPill(inv); const open = '/fleet/tolls?review=' + inv.id; %>
        <tr class="hover:bg-gray-50" style="cursor:pointer" onclick="window.location='<%= open %>'" data-toll-invoice="<%= inv.id %>">
          <td class="px-4 py-2.5">
            <a href="<%= open %>" class="font-semibold text-gray-900 hover:text-brand-700 hover:underline whitespace-nowrap"><%= range(inv.period_start, inv.period_end) %></a>
            <p class="text-[10px] text-gray-400 mt-0.5">Invoice <span class="font-mono"><%= inv.invoice_number %></span> · <%= inv.page_count || '?' %> pages · uploaded <%= formatDateShort(inv.created_at) %></p>
          </td>
          <td class="px-3 py-2.5 text-xs text-gray-500 whitespace-nowrap hidden sm:table-cell"><%= inv.period_end ? (new Date(inv.period_end + 'T00:00:00').getFullYear()) : '' %></td>
          <td class="px-3 py-2.5 text-xs text-gray-500 hidden md:table-cell"><%= inv.issue_date ? formatDateShort(inv.issue_date) : '-' %></td>
          <td class="px-3 py-2.5 text-right text-xs font-semibold text-gray-800"><%= AUD(inv.total_tolls) %></td>
          <td class="px-3 py-2.5 text-right text-xs text-gray-600 hidden sm:table-cell"><%= AUD(inv.total_fees) %></td>
          <td class="px-3 py-2.5 text-right text-xs font-bold text-gray-900"><%= AUD((Number(inv.total_tolls) || 0) + (Number(inv.total_fees) || 0)) %></td>
          <td class="px-3 py-2.5 text-xs text-gray-600 hidden lg:table-cell">
            <%= c.applied %> of <%= c.sections %> added
            <% if (c.unmatched) { %><span class="block text-amber-700 font-medium"><%= c.unmatched %> need<%= c.unmatched === 1 ? 's' : '' %> a vehicle</span><% } %>
          </td>
          <td class="px-3 py-2.5"><span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-bold whitespace-nowrap <%= pill[1] %>"><%= pill[0] %></span></td>
          <td class="px-3 py-2.5 text-right whitespace-nowrap" onclick="event.stopPropagation()">
            <a href="<%= open %>" class="text-xs font-medium text-brand-600 hover:underline">Open</a>
            <a href="/fleet/tolls/<%= inv.id %>/file" target="_blank" class="text-xs text-gray-500 hover:text-gray-900 ml-2">PDF</a>
            <form method="POST" action="/fleet/tolls/<%= inv.id %>/delete" class="inline ml-2" onsubmit="return confirm('Delete statement <%= inv.invoice_number %>? Every trip added from it is removed from the vehicles too.')">
              <%- include('../partials/csrf') %>
              <button type="submit" class="text-xs text-red-500 hover:text-red-700">Delete</button>
            </form>
          </td>
        </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
  <% } %>
</div>

<% if (review) { %><%- include('./_toll_review', { review, AUD }) %><% } %>

<style>
  /* Same drop box as the vehicle service-invoice form (detail.ejs). */
  .invoice-drop { display: block; position: relative; border: 2px dashed #CBD5E1; border-radius: 12px; padding: 18px; background: #F8FAFC; cursor: pointer; transition: border-color 120ms ease, background 120ms ease; text-align: center; }
  .invoice-drop:hover, .invoice-drop.is-drag { border-color: #10B981; background: #ECFDF5; }
  .invoice-drop-input { position: absolute; inset: 0; opacity: 0; cursor: pointer; }
  .invoice-drop-body { pointer-events: none; }
  .invoice-drop-chosen { display: none; align-items: center; justify-content: center; gap: 8px; flex-wrap: wrap; }
  .invoice-drop.is-chosen .invoice-drop-body { display: none; }
  .invoice-drop.is-chosen .invoice-drop-chosen { display: flex; }
  :root[data-theme="dark"] .invoice-drop { border-color: rgba(255,255,255,0.28); background: rgba(255,255,255,0.05); }
  :root[data-theme="dark"] .invoice-drop:hover, :root[data-theme="dark"] .invoice-drop.is-drag { border-color: #34D399; background: rgba(52,211,153,0.12); }
  :root[data-theme="dark"] .invoice-drop .invoice-drop-lead { color: #F1F5FF; }
  :root[data-theme="dark"] .invoice-drop .invoice-drop-hint { color: rgba(255,255,255,0.6); }
  :root[data-theme="dark"] .invoice-drop .invoice-drop-ico { color: rgba(255,255,255,0.55); }
  :root[data-theme="dark"] .invoice-drop .invoice-drop-name { color: #E8EEFC; }
</style>
<script>
(function () {
  var drop = document.getElementById('tollDrop');
  var input = document.getElementById('tollFile');
  var form = document.getElementById('tollUploadForm');
  if (!drop || !input || !form) return;
  var busy = false;
  function chosen() {
    if (busy || !input.files || !input.files.length) return;
    var files = Array.prototype.slice.call(input.files);
    var bad = files.filter(function (f) { return !/\.pdf$/i.test(f.name); });
    if (bad.length) { alert('Toll statements must be PDF files: ' + bad.map(function (f) { return f.name; }).join(', ')); input.value = ''; return; }
    if (files.length > 12) { alert('Up to 12 statements at once, please.'); input.value = ''; return; }
    busy = true;
    drop.querySelector('.invoice-drop-name').textContent = files.length === 1 ? files[0].name : files.length + ' statements';
    drop.querySelector('[data-reading-note]').textContent = files.length === 1 ? 'Reading the statement…' : 'Reading and filing them by period…';
    drop.classList.add('is-chosen');
    form.submit(); // one step: drop it, it's read
  }
  input.addEventListener('change', chosen);
  ['dragenter', 'dragover'].forEach(function (ev) { drop.addEventListener(ev, function (e) { e.preventDefault(); drop.classList.add('is-drag'); }); });
  ['dragleave', 'drop'].forEach(function (ev) { drop.addEventListener(ev, function (e) { e.preventDefault(); drop.classList.remove('is-drag'); }); });
  drop.addEventListener('drop', function (e) {
    if (e.dataTransfer && e.dataTransfer.files && e.dataTransfer.files.length) { input.files = e.dataTransfer.files; chosen(); }
  });
})();
</script>
