<%
// Company meeting page — the minutes are a list of discussion items, each
// optionally tagged to a department, each with its own to-dos. Tagged items
// and to-dos render on that department's hub straight from these rows, so a
// tick there is a tick here. Each item is its own form (same rationale as
// the dept notebook's per-section forms: saving one never clobbers a
// colleague's edit in another).
function fmtTime(hhmm) {
  const m = String(hhmm || '').match(/^(\d{1,2}):(\d{2})$/);
  if (!m) return '';
  let h = parseInt(m[1], 10);
  const ap = h >= 12 ? 'pm' : 'am';
  h = h % 12 || 12;
  return h + ':' + m[2] + ' ' + ap;
}
const isClientMeeting = meeting.meeting_type === 'client';
const subtitleBits = [formatDate(meeting.meeting_date)];
if (meeting.meeting_time) subtitleBits.push(fmtTime(meeting.meeting_time));
if (isClientMeeting && clientName) subtitleBits.push(clientName);
if (meeting.attendees) subtitleBits.push(meeting.attendees);
const deptLabel = {};
depts.forEach(function (d) { deptLabel[d.key] = d.label; });
function fmtKB(n) { if (!n) return ''; return n < 1048576 ? Math.round(n / 1024) + ' KB' : (n / 1048576).toFixed(1) + ' MB'; }
%>

<%- include('../partials/page-header', {
  eyebrow: isClientMeeting ? 'Client meeting' : 'Company meeting',
  title: meeting.title,
  subtitle: subtitleBits.join(' · '),
  rail: true,
  actions: [
    { label: 'Meetings', href: '/meetings', style: 'secondary' },
    { label: 'Edit details', href: '#edit', style: 'secondary' },
    { label: 'Export PDF', href: '/meetings/' + meeting.id + '/pdf', style: 'primary' }
  ]
}) %>

<% if (meeting.status === 'cancelled') { %>
  <div class="max-w-4xl flex items-center justify-between gap-3 bg-amber-50 border border-amber-200 rounded-xl p-4 mb-5">
    <p class="text-sm text-amber-800 font-medium">This meeting was cancelled.</p>
    <form method="POST" action="/meetings/<%= meeting.id %>/cancel">
      <%- include('../partials/csrf') %>
      <button type="submit" class="px-3 py-1.5 bg-white border border-amber-300 hover:bg-amber-100 text-amber-800 text-xs font-semibold rounded-lg transition-colors">Restore meeting</button>
    </form>
  </div>
<% } %>

<%
// One to-do row — toggle, text (struck through when done), its own dept
// select (a to-do routes to a hub by ITS tag, not its item's — the select
// posts on change), hover delete.
function todoRow(t) { %>
  <div class="flex items-start gap-2 group">
    <form method="POST" action="/meetings/<%= meeting.id %>/todos/<%= t.id %>/toggle" class="shrink-0 pt-0.5">
      <%- include('../partials/csrf') %>
      <button type="submit" title="<%= t.done ? 'Reopen' : 'Mark done' %>"
        class="w-4 h-4 rounded border flex items-center justify-center transition-colors <%= t.done ? 'bg-emerald-500 border-emerald-500' : 'border-gray-300 hover:border-brand-500 hover:bg-brand-50' %>">
        <% if (t.done) { %><svg class="w-3 h-3 text-white" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg><% } %>
      </button>
    </form>
    <p class="flex-1 min-w-0 text-sm leading-snug <%= t.done ? 'line-through text-gray-400' : 'text-gray-800' %>">
      <%= t.text %>
      <% if (t.priority === 'high') { %><span class="ml-1 inline-block px-1 py-px rounded text-[9px] font-bold bg-red-50 text-red-600 align-middle">HIGH</span><% } %>
    </p>
    <form method="POST" action="/meetings/<%= meeting.id %>/todos/<%= t.id %>/dept" class="shrink-0">
      <%- include('../partials/csrf') %>
      <select name="dept_key" onchange="this.form.submit()" title="Department — the to-do shows on this department's hub"
        class="max-w-[7.5rem] px-1.5 py-0.5 bg-transparent border border-transparent hover:border-gray-300 rounded text-[10px] font-semibold <%= t.dept_key ? 'text-brand-700' : 'text-gray-400' %> focus:outline-none focus:ring-1 focus:ring-brand-500 cursor-pointer">
        <option value="">General</option>
        <% depts.forEach(function (d) { %>
          <option value="<%= d.key %>" <%= t.dept_key === d.key ? 'selected' : '' %>><%= d.label %></option>
        <% }); %>
      </select>
    </form>
    <form method="POST" action="/meetings/<%= meeting.id %>/todos/<%= t.id %>/delete" class="shrink-0 opacity-0 group-hover:opacity-100 transition-opacity">
      <%- include('../partials/csrf') %>
      <button type="submit" class="text-gray-300 hover:text-red-500 text-sm leading-none px-1" title="Delete">×</button>
    </form>
  </div>
<% }

// Compact add-a-to-do form; item_id '' = a meeting-level (General) to-do.
// The dept select defaults to the item's tag but each to-do owns its own.
function addTodoForm(itemId, defaultDept) { %>
  <form method="POST" action="/meetings/<%= meeting.id %>/todos" class="flex gap-1.5 mt-2">
    <%- include('../partials/csrf') %>
    <input type="hidden" name="item_id" value="<%= itemId || '' %>">
    <input type="text" name="text" required placeholder="Add a to-do…"
      class="flex-1 min-w-0 px-2.5 py-1.5 bg-white border border-gray-300 rounded-lg text-gray-900 text-xs focus:outline-none focus:ring-2 focus:ring-brand-500">
    <select name="dept_key" title="Department — the to-do shows on this department's hub"
      class="px-2 py-1.5 bg-white border border-gray-300 rounded-lg text-gray-600 text-xs focus:outline-none focus:ring-2 focus:ring-brand-500">
      <option value="">General</option>
      <% depts.forEach(function (d) { %>
        <option value="<%= d.key %>" <%= defaultDept === d.key ? 'selected' : '' %>><%= d.label %></option>
      <% }); %>
    </select>
    <select name="priority" class="px-2 py-1.5 bg-white border border-gray-300 rounded-lg text-gray-600 text-xs focus:outline-none focus:ring-2 focus:ring-brand-500">
      <option value="low">Low</option>
      <option value="high">High</option>
    </select>
    <button type="submit" class="px-2.5 py-1.5 bg-gray-100 hover:bg-brand-50 border border-gray-200 hover:border-brand-200 text-gray-600 hover:text-brand-700 text-xs font-bold rounded-lg transition-colors">+ Add</button>
  </form>
<% }

// Dept select shared by item forms — '' = General (no hub slice).
function deptSelect(selected) { %>
  <select name="dept_key" class="px-2 py-1.5 bg-white border border-gray-300 rounded-lg text-gray-700 text-xs focus:outline-none focus:ring-2 focus:ring-brand-500" title="Department — tagged items appear on that department's hub">
    <option value="">General</option>
    <% depts.forEach(function (d) { %>
      <option value="<%= d.key %>" <%= selected === d.key ? 'selected' : '' %>><%= d.label %></option>
    <% }); %>
  </select>
<% } %>

<%
// One attachment: image → thumbnail with caption; file → link chip.
// Both get a caption editor + delete on hover.
function attachmentBlock(a) { %>
  <div class="group/att">
    <% if (a.is_image) { %>
      <a href="/<%= a.file_path %>" target="_blank" class="block rounded-lg overflow-hidden border border-gray-200 bg-gray-50">
        <img src="/<%= a.file_path %>" alt="<%= a.caption || a.original_name %>" loading="lazy" class="w-full h-36 object-cover">
      </a>
    <% } else { %>
      <a href="/<%= a.file_path %>" target="_blank" class="flex items-center gap-2 px-2.5 py-2 rounded-lg border border-gray-200 bg-gray-50 hover:bg-gray-100 transition-colors">
        <svg class="w-4 h-4 text-gray-400 shrink-0" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M13.828 10.172a4 4 0 010 5.656l-3 3a4 4 0 01-5.656-5.656l1.5-1.5m10.656-1.344l1.5-1.5a4 4 0 00-5.656-5.656l-3 3a4 4 0 000 5.656"/></svg>
        <span class="flex-1 min-w-0 text-xs font-medium text-gray-700 truncate"><%= a.original_name %></span>
        <span class="text-[10px] text-gray-400 shrink-0"><%= fmtKB(a.size_bytes) %></span>
      </a>
    <% } %>
    <div class="flex items-center gap-1 mt-1">
      <form method="POST" action="/meetings/<%= meeting.id %>/attachments/<%= a.id %>/caption" class="flex-1 min-w-0 flex gap-1">
        <%- include('../partials/csrf') %>
        <input type="text" name="caption" value="<%= a.caption || '' %>" placeholder="<%= a.is_image ? 'Add a caption…' : 'Note…' %>"
          class="flex-1 min-w-0 px-2 py-1 bg-transparent border border-transparent hover:border-gray-200 focus:border-gray-300 focus:bg-white rounded text-[11px] text-gray-600 italic focus:outline-none focus:ring-1 focus:ring-brand-500">
        <button type="submit" class="opacity-0 group-focus-within/att:opacity-100 px-1.5 text-[10px] font-bold text-brand-600 hover:text-brand-700 shrink-0">Save</button>
      </form>
      <form method="POST" action="/meetings/<%= meeting.id %>/attachments/<%= a.id %>/delete" class="shrink-0 opacity-0 group-hover/att:opacity-100 transition-opacity"
            onsubmit="return confirm('Remove this <%= a.is_image ? 'photo' : 'file' %>?');">
        <%- include('../partials/csrf') %>
        <button type="submit" class="text-gray-300 hover:text-red-500 text-sm leading-none px-1" title="Remove">×</button>
      </form>
    </div>
  </div>
<% }

// Grid wrapper — images sit side-by-side, files stack full-width.
function attachmentGrid(list) {
  const imgs = list.filter(function (a) { return a.is_image; });
  const files = list.filter(function (a) { return !a.is_image; }); %>
  <% if (imgs.length) { %>
    <div class="grid grid-cols-2 sm:grid-cols-3 gap-2 mt-2">
      <% imgs.forEach(function (a) { attachmentBlock(a); }); %>
    </div>
  <% } %>
  <% if (files.length) { %>
    <div class="space-y-1.5 mt-2">
      <% files.forEach(function (a) { attachmentBlock(a); }); %>
    </div>
  <% } %>
<% }

// Compact photo/file uploader — one per scope (heading or dot point).
function attachForm(sectionId, pointId, label) { %>
  <details class="mt-1.5 group/up">
    <summary class="cursor-pointer inline-flex items-center gap-1 text-[11px] font-semibold text-gray-400 hover:text-brand-600 list-none select-none">
      <svg class="w-3 h-3" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"/></svg>
      <%= label %>
    </summary>
    <form method="POST" action="/meetings/<%= meeting.id %>/attachments" enctype="multipart/form-data" class="mt-2 p-2.5 bg-gray-50 rounded-lg flex flex-wrap items-center gap-2">
      <input type="hidden" name="section_id" value="<%= sectionId %>">
      <input type="hidden" name="point_id" value="<%= pointId || '' %>">
      <input type="file" name="files" multiple required accept=".pdf,.doc,.docx,.xls,.xlsx,.csv,.txt,.png,.jpg,.jpeg,.gif,.webp,.heic"
        class="flex-1 min-w-[150px] text-xs text-gray-600 file:mr-2 file:py-1.5 file:px-2.5 file:rounded file:border-0 file:text-xs file:font-medium file:bg-brand-50 file:text-brand-700 hover:file:bg-brand-100">
      <input type="text" name="caption" placeholder="Caption (shows under photos in the PDF)"
        class="flex-1 min-w-[160px] px-2.5 py-1.5 bg-white border border-gray-300 rounded-lg text-xs focus:outline-none focus:ring-2 focus:ring-brand-500">
      <button type="submit" class="px-3 py-1.5 bg-brand-600 hover:bg-brand-500 text-white text-xs font-semibold rounded-lg transition-colors shrink-0">Attach</button>
    </form>
  </details>
<% } %>

<div class="max-w-4xl space-y-5">

  <!-- ── Minutes: your own headings, dot points under each, photos/files
          under either. This is what the PDF export renders. ─────────── -->
  <% sections.forEach(function (sec, sIdx) {
       const secPoints = pointsBySection.get(sec.id) || [];
       const secAtts = attachmentsBySection.get(sec.id) || []; %>
    <div id="section-<%= sec.id %>" class="bg-white border border-gray-200 rounded-xl shadow-sm scroll-mt-20 group/sec">
      <div class="flex items-center gap-2.5 px-5 pt-4 pb-3 border-b border-gray-100">
        <span class="w-6 h-6 rounded-lg bg-emerald-50 text-brand-700 text-[11px] font-bold flex items-center justify-center shrink-0 ring-1 ring-emerald-100"><%= sIdx + 1 %></span>
        <form method="POST" action="/meetings/<%= meeting.id %>/sections/<%= sec.id %>" class="flex-1 min-w-0 flex items-center gap-1.5">
          <%- include('../partials/csrf') %>
          <input type="text" name="title" required value="<%= sec.title %>"
            class="flex-1 min-w-0 px-2 py-1 bg-transparent border border-transparent hover:border-gray-200 focus:border-gray-300 focus:bg-white rounded-lg text-sm font-bold text-gray-900 focus:outline-none focus:ring-2 focus:ring-brand-500">
          <button type="submit" class="opacity-0 group-focus-within/sec:opacity-100 px-2 py-1 text-[10px] font-bold text-brand-600 hover:text-brand-700 shrink-0">Save</button>
        </form>
        <form method="POST" action="/meetings/<%= meeting.id %>/sections/<%= sec.id %>/delete" class="shrink-0 opacity-0 group-hover/sec:opacity-100 transition-opacity"
              onsubmit="return confirm('Delete this heading, its dot points and their photos/files?');">
          <%- include('../partials/csrf') %>
          <button type="submit" class="text-gray-300 hover:text-red-500 text-lg leading-none px-1" title="Delete heading">×</button>
        </form>
      </div>
      <div class="p-5 pt-3.5 space-y-2.5">
        <% secPoints.forEach(function (p) {
             const pAtts = attachmentsByPoint.get(p.id) || []; %>
          <div class="group/pt">
            <div class="flex items-start gap-2">
              <span class="mt-2 w-1.5 h-1.5 rounded-full bg-brand-600 shrink-0"></span>
              <form method="POST" action="/meetings/<%= meeting.id %>/points/<%= p.id %>" class="flex-1 min-w-0 flex items-start gap-1.5">
                <%- include('../partials/csrf') %>
                <input type="text" name="text" required value="<%= p.text %>"
                  class="flex-1 min-w-0 px-2 py-1 bg-transparent border border-transparent hover:border-gray-200 focus:border-gray-300 focus:bg-white rounded text-sm text-gray-800 leading-snug focus:outline-none focus:ring-2 focus:ring-brand-500">
                <button type="submit" class="opacity-0 group-focus-within/pt:opacity-100 px-1.5 py-1 text-[10px] font-bold text-brand-600 hover:text-brand-700 shrink-0">Save</button>
              </form>
              <form method="POST" action="/meetings/<%= meeting.id %>/points/<%= p.id %>/delete" class="shrink-0 opacity-0 group-hover/pt:opacity-100 transition-opacity"
                    onsubmit="return confirm('Delete this dot point<%= pAtts.length ? ' and its photos/files' : '' %>?');">
                <%- include('../partials/csrf') %>
                <button type="submit" class="text-gray-300 hover:text-red-500 text-sm leading-none px-1" title="Delete point">×</button>
              </form>
            </div>
            <div class="ml-5">
              <% if (pAtts.length) { attachmentGrid(pAtts); } %>
              <% attachForm(sec.id, p.id, 'Photo / file for this point'); %>
            </div>
          </div>
        <% }); %>

        <!-- Add dot point -->
        <form method="POST" action="/meetings/<%= meeting.id %>/sections/<%= sec.id %>/points" class="flex gap-1.5 pt-1">
          <%- include('../partials/csrf') %>
          <input type="text" name="text" required placeholder="Add a dot point…"
            class="flex-1 min-w-0 px-2.5 py-1.5 bg-white border border-gray-300 rounded-lg text-gray-900 text-xs focus:outline-none focus:ring-2 focus:ring-brand-500">
          <button type="submit" class="px-2.5 py-1.5 bg-gray-100 hover:bg-brand-50 border border-gray-200 hover:border-brand-200 text-gray-600 hover:text-brand-700 text-xs font-bold rounded-lg transition-colors">+ Add</button>
        </form>

        <!-- Heading-level photos & files -->
        <div class="pt-2 border-t border-gray-50">
          <% if (secAtts.length) { attachmentGrid(secAtts); } %>
          <% attachForm(sec.id, null, 'Photo / file for this heading'); %>
        </div>
      </div>
    </div>
  <% }); %>

  <!-- Add heading -->
  <div id="add-section" class="bg-white border border-dashed border-gray-300 rounded-xl scroll-mt-20">
    <form method="POST" action="/meetings/<%= meeting.id %>/sections" class="p-5 flex flex-wrap items-end gap-2">
      <%- include('../partials/csrf') %>
      <div class="flex-1 min-w-[220px]">
        <p class="text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-2">Add heading</p>
        <input type="text" name="title" required placeholder="e.g. Site access, Program, Variations…"
          class="w-full px-3 py-2 bg-white border border-gray-300 rounded-lg text-gray-900 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500">
      </div>
      <button type="submit" class="px-4 py-2 bg-brand-600 hover:bg-brand-500 text-white text-sm font-semibold rounded-lg transition-colors">Add heading</button>
      <p class="w-full text-[11px] text-gray-400">Headings structure the minutes — add dot points under each, attach photos (with captions) and files, then use <span class="font-semibold">Export PDF</span> up top.</p>
    </form>
  </div>

  <% if (!isClientMeeting) { %>
  <% if (!items.length) { %>
    <div class="bg-white border border-gray-200 rounded-xl shadow-sm p-6 text-center">
      <p class="text-gray-400 text-sm">No discussion items yet — add the first one below.</p>
    </div>
  <% } %>

  <% items.forEach(function (item, idx) {
       const itemTodos = todosByItem.get(item.id) || []; %>
    <div id="item-<%= item.id %>" class="bg-white border border-gray-200 rounded-xl shadow-sm scroll-mt-20 group/item">
      <div class="flex items-center justify-between gap-2 px-5 pt-4 pb-3 border-b border-gray-100">
        <div class="flex items-center gap-2.5 min-w-0">
          <span class="w-6 h-6 rounded-full bg-brand-600 text-white text-[11px] font-bold flex items-center justify-center shrink-0"><%= idx + 1 %></span>
          <% if (item.dept_key && deptLabel[item.dept_key]) { %>
            <span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-brand-50 text-brand-700 uppercase tracking-wide shrink-0"><%= deptLabel[item.dept_key] %></span>
          <% } else { %>
            <span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-gray-100 text-gray-500 uppercase tracking-wide shrink-0">General</span>
          <% } %>
        </div>
        <form method="POST" action="/meetings/<%= meeting.id %>/items/<%= item.id %>/delete" class="shrink-0 opacity-0 group-hover/item:opacity-100 transition-opacity"
              onsubmit="return confirm('Delete this discussion item? Its to-dos are kept under General to-dos.');">
          <%- include('../partials/csrf') %>
          <button type="submit" class="text-gray-300 hover:text-red-500 text-lg leading-none px-1" title="Delete item">×</button>
        </form>
      </div>
      <div class="p-5 pt-4">
        <form method="POST" action="/meetings/<%= meeting.id %>/items/<%= item.id %>">
          <%- include('../partials/csrf') %>
          <textarea name="body" rows="3" required
            class="w-full px-3 py-2.5 bg-white border border-gray-300 rounded-lg text-gray-900 text-sm leading-relaxed focus:outline-none focus:ring-2 focus:ring-brand-500"><%= item.body %></textarea>
          <div class="flex items-center justify-between gap-2 mt-2">
            <% deptSelect(item.dept_key); %>
            <button type="submit" class="px-4 py-1.5 bg-white border border-gray-300 hover:bg-gray-50 text-gray-700 text-xs font-semibold rounded-lg transition-colors">Save</button>
          </div>
        </form>

        <div class="mt-4 pt-3 border-t border-gray-50">
          <p class="text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-2">To-dos</p>
          <div class="space-y-1">
            <% if (!itemTodos.length) { %><p class="text-xs text-gray-300 italic py-0.5">None yet.</p><% } %>
            <% itemTodos.forEach(function (t) { todoRow(t); }); %>
          </div>
          <% addTodoForm(item.id, item.dept_key); %>
        </div>
      </div>
    </div>
  <% }); %>

  <!-- Add discussion item -->
  <div id="add-item" class="bg-white border border-dashed border-gray-300 rounded-xl scroll-mt-20">
    <form method="POST" action="/meetings/<%= meeting.id %>/items" class="p-5">
      <p class="text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-2">Add discussion item</p>
      <%- include('../partials/csrf') %>
      <textarea name="body" rows="3" required placeholder="What was discussed? Tag it to a department and it shows up on that department's hub."
        class="w-full px-3 py-2.5 bg-white border border-gray-300 rounded-lg text-gray-900 text-sm leading-relaxed focus:outline-none focus:ring-2 focus:ring-brand-500"></textarea>
      <div class="flex items-center justify-between gap-2 mt-2">
        <% deptSelect(null); %>
        <button type="submit" class="px-4 py-2 bg-brand-600 hover:bg-brand-500 text-white text-sm font-semibold rounded-lg transition-colors">Add item</button>
      </div>
    </form>
  </div>

  <!-- General to-dos: meeting-level adds + survivors of deleted items -->
  <div id="general-todos" class="bg-white border border-gray-200 rounded-xl shadow-sm scroll-mt-20">
    <div class="flex items-center gap-2.5 px-5 pt-4 pb-3 border-b border-gray-100">
      <p class="text-[11px] font-bold text-gray-700 uppercase tracking-widest">General to-dos</p>
      <span class="text-[11px] text-gray-400 normal-case">not tied to a discussion item</span>
    </div>
    <div class="p-5 pt-4">
      <div class="space-y-1">
        <% if (!generalTodos.length) { %><p class="text-xs text-gray-300 italic py-0.5">None yet.</p><% } %>
        <% generalTodos.forEach(function (t) { todoRow(t); }); %>
      </div>
      <% addTodoForm(null, null); %>
    </div>
  </div>
  <% } %><%# end !isClientMeeting — dept-tagged items/to-dos are internal machinery %>

  <!-- Footer actions -->
  <div class="flex items-center justify-end gap-4 pb-6">
    <form method="POST" action="/meetings/<%= meeting.id %>/cancel">
      <%- include('../partials/csrf') %>
      <button type="submit" class="text-xs font-medium text-gray-400 hover:text-gray-600"><%= meeting.status === 'cancelled' ? 'Restore meeting' : 'Cancel meeting' %></button>
    </form>
    <% if (canDelete) { %>
      <form method="POST" action="/meetings/<%= meeting.id %>/delete" onsubmit="return confirm('Delete this meeting and all its items and to-dos?');">
        <%- include('../partials/csrf') %>
        <button type="submit" class="text-xs font-medium text-red-400 hover:text-red-600">Delete meeting</button>
      </form>
    <% } %>
  </div>

  <!-- Edit details -->
  <details id="edit" class="bg-white border border-gray-200 rounded-xl shadow-sm scroll-mt-20">
    <summary class="cursor-pointer px-5 py-3 text-sm font-medium text-gray-600 hover:text-gray-900 select-none">Edit meeting details</summary>
    <form method="POST" action="/meetings/<%= meeting.id %>" class="px-5 pb-5 pt-1 grid sm:grid-cols-2 gap-3">
      <%- include('../partials/csrf') %>
      <div class="sm:col-span-2">
        <label class="block text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-1">Title</label>
        <input type="text" name="title" required value="<%= meeting.title %>"
          class="w-full px-3 py-2 bg-white border border-gray-300 rounded-lg text-gray-900 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500">
      </div>
      <div>
        <label class="block text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-1">Date</label>
        <input type="date" name="meeting_date" required value="<%= meeting.meeting_date %>"
          class="w-full px-3 py-2 bg-white border border-gray-300 rounded-lg text-gray-900 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500">
      </div>
      <div>
        <label class="block text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-1">Time</label>
        <input type="time" name="meeting_time" value="<%= meeting.meeting_time %>"
          class="w-full px-3 py-2 bg-white border border-gray-300 rounded-lg text-gray-900 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500">
      </div>
      <div class="sm:col-span-2">
        <label class="block text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-1">Attendees</label>
        <input type="text" name="attendees" value="<%= meeting.attendees %>"
          class="w-full px-3 py-2 bg-white border border-gray-300 rounded-lg text-gray-900 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500">
      </div>
      <div>
        <label class="block text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-1">Meeting type</label>
        <select name="meeting_type" class="w-full px-3 py-2 bg-white border border-gray-300 rounded-lg text-gray-900 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500">
          <option value="company" <%= !isClientMeeting ? 'selected' : '' %>>Company meeting</option>
          <option value="client" <%= isClientMeeting ? 'selected' : '' %>>Client meeting</option>
        </select>
      </div>
      <div>
        <label class="block text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-1">Client <span class="normal-case font-normal">(client meetings)</span></label>
        <select name="client_id" class="w-full px-3 py-2 bg-white border border-gray-300 rounded-lg text-gray-900 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500">
          <option value="">— None —</option>
          <% (typeof clients !== 'undefined' ? clients : []).forEach(function (c) { %>
            <option value="<%= c.id %>" <%= meeting.client_id === c.id ? 'selected' : '' %>><%= c.company_name %></option>
          <% }); %>
        </select>
      </div>
      <div class="sm:col-span-2">
        <button type="submit" class="px-4 py-2 bg-brand-600 hover:bg-brand-500 text-white text-sm font-semibold rounded-lg transition-colors">Save details</button>
      </div>
    </form>
  </details>
</div>
