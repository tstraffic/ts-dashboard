<%
  // Sub-plan card — slimmed to the essentials per type (Aug 2026 redesign):
  //   every card:  ref + status header, owner, Task button, approve/reject/
  //                delete, supporting documents
  //   TGS:         RA row, linked-ROL chips, submit form
  //   TMP/CTMP:    QA select, submit form, revisions (+ button)
  //   ROL:         licence number beside the TS ref, approved banner,
  //                condition alerts, Covers chips, one-drop auto-approve
  //                (parse → approved in one step), extensions (+ button,
  //                auto-moves the effective end), collapsed manual entry
  //   Council:     two-stage apply/approve + itemised fees + application ref
  //   other types: submit form
  // Client charging moved to the plan-level Quote tab; per-card charge, P&L
  // and the everywhere-Fees disclosure are gone.
  const isROL = sub.item_type === 'rol' || sub.item_type === 'road_occupancy';
  const rolApplied = sub.rol_applied_date || '';
  const rolApproved = sub.status === 'approved' || sub.rol_stage === 'approved';
  const rolExpiryStr = rolApplied ? new Date(Date.parse(rolApplied + 'T00:00:00Z') + 14 * 86400000).toISOString().slice(0, 10) : '';
  const rolChaseFrom = rolApplied ? new Date(Date.parse(rolApplied + 'T00:00:00Z') + 10 * 86400000).toISOString().slice(0, 10) : '';
  const rolTodayStr = new Date().toISOString().slice(0, 10);
  const rolExpired = rolApplied && !rolApproved && rolTodayStr > rolExpiryStr;
  const rolInChase = rolApplied && !rolApproved && !rolExpired && rolTodayStr >= rolChaseFrom;
  const rolLinkList = (typeof rolSubs !== 'undefined' && rolSubs) ? rolSubs : [];
  const rolLinkLabel = (r) => (r.rol_actual_number || r.reference_number || ('ROL #' + r.id));
  const myRolLinks = (typeof rolLinks !== 'undefined' && rolLinks) ? rolLinks.map(Number) : [];
  const myTgsBacklinks = (typeof tgsBacklinks !== 'undefined' && tgsBacklinks) ? tgsBacklinks.map(Number) : [];
  const tgsLinkList = (typeof tgsSubs !== 'undefined' && tgsSubs) ? tgsSubs : [];
  const isSubmitted = ['submitted', 'approved'].includes(sub.status);
  const isApproved = sub.status === 'approved';
  const isRejected = sub.status === 'rejected';
  const docCount = (docs || []).length;
  const linkedRa = (typeof ra !== 'undefined' && ra) ? ra : null;
  const isTgs = sub.item_type === 'traffic_guidance';
  const raActive = linkedRa && linkedRa.status === 'active';
  const raStatusColor = linkedRa
    ? (linkedRa.status === 'active' ? 'bg-emerald-50 text-emerald-700 ring-emerald-200'
       : linkedRa.status === 'archived' ? 'bg-gray-100 text-gray-600 ring-gray-200'
       : 'bg-amber-50 text-amber-700 ring-amber-200')
    : '';
  const cFees = (typeof fees !== 'undefined' && fees) ? fees : [];
  const feesTotal = cFees.reduce((s, f) => s + (parseFloat(f.amount) || 0), 0);
  const cExt = (typeof extensions !== 'undefined' && extensions) ? extensions : [];
  const cShifts = (typeof rolShifts !== 'undefined' && rolShifts) ? rolShifts : [];
  const cConds = (typeof rolConditions !== 'undefined' && rolConditions) ? rolConditions : [];
  const isCouncilType = sub.item_type === 'council_permit';
  const isCtmpType = sub.item_type === 'tmp_approval';
  const isRolType = isROL;
  const condAlerts = cConds.filter(c => c.is_alert);
  const qaCol = { pending: 'bg-gray-100 text-gray-600', in_qa: 'bg-amber-100 text-amber-700', approved: 'bg-emerald-100 text-emerald-700' };
  const subRevs = (typeof subPlanRevisions !== 'undefined' && subPlanRevisions) ? (subPlanRevisions[sub.id] || []) : [];
  const openTaskCount = (typeof subPlanOpenTasks !== 'undefined' && subPlanOpenTasks) ? (subPlanOpenTasks[sub.id] || 0) : 0;

  // Accordion: collapsed = one scannable row (the old summary-table info);
  // open = the full card. The parent decides the default (accOpen) — a lone
  // sub-plan opens, a stack stays collapsed for a clean overview.
  const accOpen = (typeof cardOpen !== 'undefined') ? !!cardOpen : false;
  const TYPE_CHIP = {
    traffic_guidance: ['TGS', 'bg-blue-50 text-blue-700 ring-blue-200'],
    tmp_approval: ['CTMP', 'bg-purple-50 text-purple-700 ring-purple-200'],
    rol: ['ROL', 'bg-teal-50 text-teal-700 ring-teal-200'],
    road_occupancy: ['ROL', 'bg-teal-50 text-teal-700 ring-teal-200'],
    council_permit: ['Council', 'bg-amber-50 text-amber-700 ring-amber-200'],
    spa: ['SPA', 'bg-orange-50 text-orange-700 ring-orange-200'],
    sza: ['SZA', 'bg-violet-50 text-violet-700 ring-violet-200'],
    bus_approval: ['Bus', 'bg-pink-50 text-pink-700 ring-pink-200'],
    police_notification: ['Police', 'bg-slate-100 text-slate-700 ring-slate-300'],
    letter_drop: ['Letter', 'bg-cyan-50 text-cyan-700 ring-cyan-200'],
    other: ['Other', 'bg-gray-100 text-gray-600 ring-gray-200'],
  };
  const typeChip = TYPE_CHIP[sub.item_type] || TYPE_CHIP.other;
  const keyDate = isApproved ? (sub.approved_date || sub.submitted_date) : (sub.submitted_date || sub.job_date || '');
  const ownerName = ((typeof users !== 'undefined' ? users : []).find(u => u.id == sub.assigned_to_id) || {}).full_name || '';
%>

<details id="sub-<%= sub.id %>" data-sub-card="<%= sub.id %>" <%= accOpen ? 'open' : '' %>
  class="group/acc border border-gray-200 rounded-lg transition-shadow open:shadow-sm <%= isApproved ? 'bg-emerald-50/30' : isRejected ? 'bg-rose-50/30' : 'bg-white' %>">
  <summary class="list-none cursor-pointer select-none px-3.5 py-2.5 flex items-center gap-2.5 flex-wrap rounded-lg hover:bg-gray-50/70 [&::-webkit-details-marker]:hidden">
    <svg class="w-3.5 h-3.5 text-gray-400 shrink-0 transition-transform group-open/acc:rotate-90" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
    <span class="inline-flex items-center px-1.5 py-0.5 rounded text-[10px] font-bold ring-1 ring-inset shrink-0 <%= typeChip[1] %>"><%= typeChip[0] %></span>
    <code class="text-sm font-semibold text-gray-900 shrink-0"><%= sub.reference_number %></code>
    <% if (isRolType && sub.rol_actual_number) { %>
      <span class="inline-flex items-center px-1.5 py-0.5 rounded text-[11px] font-semibold bg-teal-50 text-teal-800 ring-1 ring-teal-200 shrink-0">ROL <%= sub.rol_actual_number %></span>
    <% } %>
    <% if (sub.item_type === 'other' && sub.other_description) { %>
      <span class="text-sm text-gray-700 truncate max-w-[180px]"><%= sub.other_description %></span>
    <% } %>
    <% if (isCouncilType && sub.description) { %>
      <span class="text-sm text-gray-700 truncate max-w-[200px]" title="<%= sub.description %>"><%= sub.description %></span>
    <% } %>
    <span class="inline-flex items-center px-2 py-0.5 rounded text-[11px] font-medium ring-1 ring-inset shrink-0 <%= statusBadge[sub.status] || statusBadge.not_started %>">
      <%= (sub.status || 'not_started').replace(/_/g, ' ') %>
    </span>

    <span class="ml-auto flex items-center gap-2.5 text-xs text-gray-500 min-w-0">
      <% if (isCouncilType && sub.job_date) { %>
        <span class="hidden sm:inline shrink-0 font-bold text-gray-900">job start <%= sub.job_date %></span>
      <% } else if (sub.expiry_date) { %>
        <span class="hidden sm:inline shrink-0"><%= isRolType && cExt.length ? 'to' : 'exp' %> <%= sub.expiry_date %></span>
      <% } else if (keyDate) { %>
        <span class="hidden sm:inline shrink-0"><%= keyDate %></span>
      <% } %>
      <% if (isROL && sub.extension_required) { %>
        <span class="inline-flex items-center px-1.5 py-0.5 rounded text-[10px] font-bold bg-amber-50 text-amber-700 ring-1 ring-amber-200 shrink-0"><%= cExt.length %> ext</span>
      <% } %>
      <% if (ownerName) { %><span class="hidden md:inline truncate max-w-[110px]" title="Owner"><%= ownerName %></span><% } %>
      <% if (docCount > 0) { %>
        <span class="inline-flex items-center gap-0.5 shrink-0" title="<%= docCount %> file<%= docCount === 1 ? '' : 's' %>">
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15.172 7l-6.586 6.586a2 2 0 102.828 2.828l6.414-6.586a4 4 0 00-5.656-5.656L5.586 10.758a6 6 0 108.486 8.486L20.5 12"/></svg><%= docCount %>
        </span>
      <% } %>
      <% if (openTaskCount > 0) { %>
        <span class="inline-flex items-center px-1.5 py-0.5 rounded-full text-[10px] font-bold bg-amber-100 text-amber-700 shrink-0" data-task-chip="<%= sub.id %>"><%= openTaskCount %> task<%= openTaskCount === 1 ? '' : 's' %></span>
      <% } else { %>
        <span class="hidden" data-task-chip="<%= sub.id %>"></span>
      <% } %>
      <%# preventDefault stops the row toggling; the modal opens via the
          document-level [data-task-btn] listener, which still receives the
          click because propagation continues. %>
      <button type="button" data-task-btn="<%= sub.id %>" data-task-ref="<%= sub.reference_number || '' %>"
        onclick="event.preventDefault()"
        class="px-2 py-1 text-[11px] font-medium text-brand-700 bg-brand-50 hover:bg-brand-100 ring-1 ring-brand-200 rounded-md shrink-0">Task ↗</button>
    </span>
  </summary>

  <div class="px-4 pb-4 pt-3 border-t border-gray-100">
  <div class="flex items-start justify-between gap-3 mb-3 flex-wrap">
    <div class="flex items-center gap-2 flex-wrap">
      <form method="POST" action="/compliance/sub-plans/<%= sub.id %>/owner" class="w-[200px]"
        onsubmit="return window.__subPlanAjaxSave(event, this);" data-ajax-save>
        <%- include('../partials/csrf') %>
        <select name="assigned_to_id" onchange="window.__subPlanAjaxSave(null, this.form);"
          class="w-full px-2.5 py-1.5 text-sm bg-white border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-brand-500">
          <option value="">— Owner —</option>
          <% (typeof users !== 'undefined' ? users : []).forEach(u => { %>
            <option value="<%= u.id %>" <%= sub.assigned_to_id == u.id ? 'selected' : '' %>><%= u.full_name %></option>
          <% }) %>
        </select>
      </form>
    </div>
    <div class="shrink-0 flex items-center gap-1">
      <% if (isSubmitted && !isApproved) { %>
        <form method="POST" action="/compliance/sub-plans/<%= sub.id %>/approve" class="inline">
          <%- include('../partials/csrf') %>
          <button type="submit" class="px-2.5 py-1 text-xs font-medium text-emerald-700 bg-emerald-50 hover:bg-emerald-100 ring-1 ring-emerald-200 rounded-md">Approve</button>
        </form>
      <% } %>
      <% if (!isApproved && !isRejected) { %>
        <form method="POST" action="/compliance/sub-plans/<%= sub.id %>/reject" class="inline">
          <%- include('../partials/csrf') %>
          <button type="submit" class="px-2.5 py-1 text-xs font-medium text-rose-700 bg-rose-50 hover:bg-rose-100 ring-1 ring-rose-200 rounded-md">Reject</button>
        </form>
      <% } %>
      <form method="POST" action="/compliance/sub-plans/<%= sub.id %>/delete" class="inline" onsubmit="return confirm('Remove this sub-plan and its files?')">
        <%- include('../partials/csrf') %>
        <button type="submit" title="Remove" class="p-1.5 text-gray-400 hover:text-rose-600 rounded-md">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6M1 7h22M9 3h6a1 1 0 011 1v3H8V4a1 1 0 011-1z"/></svg>
        </button>
      </form>
    </div>
  </div>

  <!-- Risk Assessment link (TGS only) -->
  <% if (isTgs && linkedRa) { %>
    <div class="mb-3 flex flex-wrap items-center gap-2 px-3 py-2 bg-blue-50/60 ring-1 ring-blue-100 rounded text-xs">
      <span class="text-[10px] font-bold uppercase tracking-wide text-blue-700">Risk Assessment</span>
      <a href="/risk-assessments/<%= linkedRa.id %>/fill" class="text-brand-600 hover:text-brand-700 font-medium truncate"><%= linkedRa.title %></a>
      <span class="inline-flex items-center px-1.5 py-0.5 rounded text-[10px] font-medium ring-1 ring-inset <%= raStatusColor %>"><%= (linkedRa.status || 'draft').toUpperCase() %></span>
      <% if (raActive && docCount > 0) { %>
        <form method="POST" action="/risk-assessments/<%= linkedRa.id %>/generate-combined" class="ml-auto" onsubmit="return confirm('Generate the combined PDF? This replaces the bare TGS attachment with the merged RA + TGS document.')">
          <%- include('../partials/csrf') %>
          <button type="submit" class="px-2.5 py-1 bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-semibold rounded">Generate Combined PDF</button>
        </form>
      <% } else if (raActive && docCount === 0) { %>
        <span class="ml-auto text-[11px] text-gray-500 italic">Upload TGS PDF below to enable combined export</span>
      <% } else { %>
        <a href="/risk-assessments/<%= linkedRa.id %>/fill" class="ml-auto text-[11px] text-amber-700 hover:text-amber-800 font-medium">Fill out →</a>
      <% } %>
    </div>
  <% } %>

  <!-- TGS → linked ROLs -->
  <% if (isTgs) { %>
    <div class="mb-3 flex flex-wrap items-center gap-1.5 px-3 py-2 bg-teal-50/60 ring-1 ring-teal-100 rounded text-xs" data-rol-links>
      <span class="text-[10px] font-bold uppercase tracking-wide text-teal-700 mr-1">Linked ROLs</span>
      <% if (rolLinkList.length) { %>
        <% rolLinkList.forEach(r => { const isLinked = myRolLinks.includes(Number(r.id)); %>
          <span class="inline-flex items-stretch rounded overflow-hidden ring-1 <%= isLinked ? 'ring-teal-600' : 'ring-teal-200' %>">
            <form method="POST" action="/compliance/sub-plans/<%= sub.id %>/link-rol" class="inline-flex">
              <%- include('../partials/csrf') %>
              <input type="hidden" name="rol_id" value="<%= r.id %>">
              <input type="hidden" name="action" value="<%= isLinked ? 'remove' : 'add' %>">
              <button type="submit"
                class="px-2 py-0.5 text-[11px] font-medium <%= isLinked ? 'bg-teal-600 text-white hover:bg-teal-700' : 'bg-white text-teal-700 hover:bg-teal-50' %>"
                title="<%= isLinked ? 'Unlink ' + rolLinkLabel(r) : 'Link ' + rolLinkLabel(r) %>">
                <%= isLinked ? '✓ ' : '+ ' %><%= rolLinkLabel(r) %>
              </button>
            </form>
            <% if (isLinked) { %>
              <a href="#sub-<%= r.id %>" data-sub-jump="<%= r.id %>" class="inline-flex items-center px-1.5 bg-teal-700 text-white/90 hover:text-white text-[11px]" title="Jump to <%= rolLinkLabel(r) %>">→</a>
            <% } %>
          </span>
        <% }) %>
      <% } else { %>
        <span class="text-gray-500 italic">Add a ROL sub-plan to this plan to link it.</span>
      <% } %>
    </div>
  <% } %>

  <!-- ROL: approved banner / 14-day application clock -->
  <% if (isRolType && rolApproved) { %>
    <div class="mb-3 flex flex-wrap items-center gap-x-4 gap-y-1 px-3 py-2 bg-emerald-50 ring-1 ring-emerald-200 rounded text-xs text-emerald-900">
      <span class="text-[10px] font-bold uppercase tracking-wide text-emerald-700">ROL approved</span>
      <span><%= sub.approved_date || sub.submitted_date || '' %></span>
      <% if (sub.rol_summary_from) { %><span>valid <%= sub.rol_summary_from %> → <span class="font-semibold"><%= sub.expiry_date || sub.rol_summary_to || '' %></span><%= cExt.length ? ' (incl. extensions)' : '' %></span><% } %>
      <% if (sub.rol_time_window) { %><span><%= sub.rol_time_window %></span><% } %>
    </div>
  <% } else if (isRolType && rolApplied) { %>
    <div class="mb-2 flex flex-wrap items-center gap-2 px-3 py-2 rounded text-xs ring-1 <%= rolExpired ? 'bg-rose-50 ring-rose-200 text-rose-800' : (rolInChase ? 'bg-amber-50 ring-amber-200 text-amber-800' : 'bg-blue-50/60 ring-blue-100 text-blue-800') %>">
      <span class="text-[10px] font-bold uppercase tracking-wide">ROL application</span>
      <span>Applied <%= rolApplied %> · <strong><%= rolExpired ? 'EXPIRED ' + rolExpiryStr : 'expires ' + rolExpiryStr %></strong></span>
      <% if (rolInChase) { %><span class="ml-auto inline-flex items-center px-1.5 py-0.5 rounded text-[10px] font-bold bg-amber-500 text-white">Chase now</span>
      <% } else if (rolExpired) { %><span class="ml-auto inline-flex items-center px-1.5 py-0.5 rounded text-[10px] font-bold bg-rose-600 text-white">Re-apply</span><% } %>
    </div>
  <% } %>

  <!-- ROL condition alerts -->
  <% if (condAlerts.length) { %>
    <div class="mb-3 bg-rose-50 ring-1 ring-rose-200 rounded-md p-3">
      <p class="text-[10px] font-bold uppercase tracking-wide text-rose-700 mb-1.5">Conditions — read before site</p>
      <ul class="space-y-1">
        <% condAlerts.forEach(c => { %><li class="text-xs text-rose-800 flex gap-1.5"><span class="font-bold">!</span><span><%= c.text %></span></li><% }) %>
      </ul>
    </div>
  <% } %>

  <!-- CTMP QA status -->
  <% if (isCtmpType) { %>
    <div class="mb-3 flex items-center gap-2 text-xs">
      <span class="text-[10px] font-bold uppercase tracking-wide text-gray-500">CTMP QA</span>
      <% if (sub.qa_status) { %><span class="inline-flex items-center px-2 py-0.5 rounded text-[11px] font-medium <%= qaCol[sub.qa_status] || qaCol.pending %>"><%= (sub.qa_status || 'pending').replace('_',' ') %></span><% } %>
      <form method="POST" action="/compliance/sub-plans/<%= sub.id %>/qa" class="inline-flex items-center gap-1" onsubmit="return window.__subPlanAjaxSave ? window.__subPlanAjaxSave(event, this) : true;" data-ajax-save>
        <%- include('../partials/csrf') %>
        <select name="qa_status" onchange="this.form.requestSubmit ? this.form.requestSubmit() : this.form.submit()" class="px-2 py-1 text-xs bg-white border border-gray-300 rounded-md">
          <% ['pending','in_qa','approved'].forEach(s => { %><option value="<%= s %>" <%= (sub.qa_status || 'pending') === s ? 'selected' : '' %>><%= s.replace('_',' ') %></option><% }) %>
        </select>
      </form>
    </div>
  <% } %>

  <!-- CTMP revisions — "+ Revision" (compliance_revisions on this sub row) -->
  <% if (isCtmpType) { %>
    <div class="mb-3 px-3 py-2 bg-purple-50/50 ring-1 ring-purple-100 rounded text-xs">
      <div class="flex items-center gap-2 flex-wrap">
        <span class="text-[10px] font-bold uppercase tracking-wide text-purple-700">Revisions</span>
        <% subRevs.forEach(r => { %>
          <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded bg-white ring-1 ring-purple-200 text-purple-800 text-[11px] font-medium" title="<%= r.notes || '' %>">
            Rev <%= r.revision_number %><%= r.revision_date ? ' · ' + r.revision_date : '' %><%= r.client_issued ? ' · issued' : '' %>
          </span>
        <% }) %>
        <button type="button" class="px-2 py-0.5 text-[11px] font-semibold text-purple-700 bg-white hover:bg-purple-100 ring-1 ring-purple-300 rounded"
          onclick="var f=document.getElementById('rev-form-<%= sub.id %>'); f.classList.toggle('hidden'); if(!f.classList.contains('hidden'))f.querySelector('input[type=date]').focus();">+ Revision</button>
      </div>
      <form method="POST" action="/compliance/<%= sub.id %>/revisions" id="rev-form-<%= sub.id %>" class="hidden mt-2 flex flex-wrap items-center gap-2">
        <%- include('../partials/csrf') %>
        <input type="hidden" name="return_to" value="/compliance/<%= parentId %>/edit#sub-<%= sub.id %>">
        <input type="date" name="revision_date" class="px-2 py-1 text-xs border border-gray-300 rounded" value="<%= new Date().toISOString().slice(0,10) %>">
        <input type="text" name="revision_notes" placeholder="What changed?" class="flex-1 min-w-[140px] px-2 py-1 text-xs border border-gray-300 rounded">
        <label class="inline-flex items-center gap-1 text-[11px] text-gray-600"><input type="checkbox" name="client_issued" value="1" class="rounded border-gray-300"> Issued to client</label>
        <button class="px-2.5 py-1 text-[11px] font-semibold text-white bg-purple-600 hover:bg-purple-700 rounded">Add</button>
      </form>
    </div>
  <% } %>

  <!-- ROL → covered TGS sheets -->
  <% if (isRolType && myTgsBacklinks.length && tgsLinkList.length) { %>
    <div class="mb-3 flex flex-wrap items-center gap-1.5 px-3 py-2 bg-teal-50/60 ring-1 ring-teal-100 rounded text-xs" data-tgs-backlinks>
      <span class="text-[10px] font-bold uppercase tracking-wide text-teal-700 mr-1">Covers</span>
      <% tgsLinkList.filter(t => myTgsBacklinks.includes(Number(t.id))).forEach(t => { %>
        <a href="#sub-<%= t.id %>" data-sub-jump="<%= t.id %>" class="inline-flex items-center px-2 py-0.5 rounded bg-white ring-1 ring-teal-200 text-teal-700 hover:bg-teal-50 text-[11px] font-medium"><%= t.reference_number || ('TGS #' + t.id) %></a>
      <% }) %>
    </div>
  <% } %>

  <!-- ROL: one-drop auto-approve + extensions + collapsed manual entry -->
  <% if (isRolType) { %>
    <% if (!rolApproved) { %>
      <div class="mb-3 rounded-lg ring-1 ring-teal-200 bg-teal-50/50 p-3">
        <p class="text-[10px] font-bold uppercase tracking-wide text-teal-700 mb-1.5">Issued ROL — automatic</p>
        <form method="POST" action="/compliance/sub-plans/<%= sub.id %>/rol/auto" enctype="multipart/form-data" data-attach-form>
          <%- include('../partials/csrf') %>
          <div data-dropzone>
            <input type="file" name="rol_file" accept=".pdf">
            <div class="dropzone-label">
              <svg class="w-7 h-7 mx-auto mb-1.5 text-teal-500" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
              <p class="text-xs text-gray-600">Drop the <span class="font-semibold">issued ROL PDF</span> here — licence number, dates, shifts and conditions are extracted and the ROL is <span class="font-semibold text-emerald-700">approved automatically</span>.</p>
            </div>
          </div>
          <noscript><button type="submit" class="mt-1.5 px-3 py-1.5 text-xs font-medium text-white bg-teal-600 rounded-md">Read &amp; approve</button></noscript>
        </form>
        <%
          const rolDocPdfs = (docs || []).filter(d => /\.pdf$/i.test(d.original_name || d.filename || '') || String(d.mime_type || '').toLowerCase().includes('pdf'));
        %>
        <% if (rolDocPdfs.length) { %>
          <div class="mt-2 space-y-1" data-rol-existing-docs>
            <% rolDocPdfs.forEach(d => { %>
              <div class="flex flex-wrap items-center gap-2 px-2 py-1.5 bg-white ring-1 ring-gray-200 rounded text-xs">
                <span class="flex-1 min-w-0 truncate text-gray-700" title="<%= d.original_name %>"><%= d.original_name %></span>
                <form method="POST" action="/compliance/sub-plans/<%= sub.id %>/rol/auto" enctype="multipart/form-data" class="inline shrink-0">
                  <%- include('../partials/csrf') %>
                  <input type="hidden" name="existing_doc_id" value="<%= d.id %>">
                  <button class="px-2 py-0.5 text-[11px] font-medium text-emerald-700 bg-emerald-50 hover:bg-emerald-100 ring-1 ring-emerald-200 rounded">Read &amp; approve</button>
                </form>
              </div>
            <% }) %>
          </div>
        <% } %>
      </div>
    <% } %>

    <!-- Extensions: chips + "+ Extension" -->
    <div class="mb-3 px-3 py-2 bg-amber-50/50 ring-1 ring-amber-100 rounded text-xs">
      <div class="flex items-center gap-2 flex-wrap">
        <span class="text-[10px] font-bold uppercase tracking-wide text-amber-700">Extensions</span>
        <% cExt.forEach(e => { %>
          <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded bg-white ring-1 ring-amber-200 text-amber-800 text-[11px] font-medium" title="<%= e.reason || '' %>">
            <%= e.label || 'Extension' %><%= e.extended_to ? ' → ' + e.extended_to : '' %>
            <% if (e.file_path) { %><a href="<%= e.file_path %>" target="_blank" class="text-brand-600 hover:underline">file</a><% } %>
            <form method="POST" action="/compliance/sub-plans/<%= sub.id %>/extensions/<%= e.id %>/delete" class="inline" onsubmit="return confirm('Delete this extension? The effective end date recomputes.')"><%- include('../partials/csrf') %><button class="text-gray-400 hover:text-rose-600 leading-none">✕</button></form>
          </span>
        <% }) %>
        <button type="button" class="px-2 py-0.5 text-[11px] font-semibold text-amber-700 bg-white hover:bg-amber-100 ring-1 ring-amber-300 rounded"
          onclick="var f=document.getElementById('ext-form-<%= sub.id %>'); f.classList.toggle('hidden'); if(!f.classList.contains('hidden'))f.querySelector('input[type=date]').focus();">+ Extension</button>
        <% if (!cExt.length) { %><span class="text-gray-400 italic">none — add one and the effective end date moves automatically</span><% } %>
      </div>
      <form method="POST" action="/compliance/sub-plans/<%= sub.id %>/extensions" enctype="multipart/form-data" id="ext-form-<%= sub.id %>" class="hidden mt-2 flex flex-wrap items-center gap-2">
        <%- include('../partials/csrf') %>
        <label class="text-[11px] text-gray-600">Extended to <input type="date" name="extended_to" required class="ml-1 px-2 py-1 text-xs border border-gray-300 rounded"></label>
        <input type="text" name="reason" placeholder="Reason (optional)" class="flex-1 min-w-[120px] px-2 py-1 text-xs border border-gray-300 rounded">
        <input type="file" name="extension_file" accept=".pdf,.jpg,.jpeg,.png,.webp" class="text-[11px]">
        <button class="px-2.5 py-1 text-[11px] font-semibold text-white bg-amber-600 hover:bg-amber-700 rounded">Add</button>
      </form>
    </div>

    <!-- Manual / application details, collapsed -->
    <details class="mb-3 group">
      <summary class="cursor-pointer text-xs font-medium text-gray-500 hover:text-gray-700 inline-flex items-center list-none">
        <svg class="w-3.5 h-3.5 mr-1 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
        Application &amp; manual entry<% if (sub.rola_application_number) { %> · ROLA <%= sub.rola_application_number %><% } %><% if (cShifts.length) { %> · <%= cShifts.length %> shifts<% } %>
      </summary>
      <div class="mt-2 p-3 bg-gray-50 rounded-md space-y-3">
        <form method="POST" action="/compliance/sub-plans/<%= sub.id %>/rol-manual" class="bg-white ring-1 ring-gray-200 rounded p-2 space-y-2">
          <%- include('../partials/csrf') %>
          <p class="text-[10px] font-bold uppercase tracking-wide text-gray-500">Enter ROL details manually</p>
          <div class="grid grid-cols-2 gap-2">
            <label class="block">
              <span class="block text-[10px] font-semibold text-gray-500 mb-0.5">Applied-for date</span>
              <input type="date" name="rol_applied_date" value="<%= sub.rol_applied_date || '' %>" class="w-full px-2 py-1 text-xs border border-gray-300 rounded" title="Application valid 14 days from here">
            </label>
            <label class="block">
              <span class="block text-[10px] font-semibold text-gray-500 mb-0.5">ROL licence no.</span>
              <input type="text" name="rol_actual_number" value="<%= sub.rol_actual_number || '' %>" placeholder="e.g. 4412345" class="w-full px-2 py-1 text-xs border border-gray-300 rounded">
            </label>
            <label class="block">
              <span class="block text-[10px] font-semibold text-gray-500 mb-0.5">Approved from</span>
              <input type="date" name="rol_summary_from" value="<%= sub.rol_summary_from || '' %>" class="w-full px-2 py-1 text-xs border border-gray-300 rounded">
            </label>
            <label class="block">
              <span class="block text-[10px] font-semibold text-gray-500 mb-0.5">Approved to</span>
              <input type="date" name="rol_summary_to" value="<%= sub.rol_summary_to || '' %>" class="w-full px-2 py-1 text-xs border border-gray-300 rounded">
            </label>
            <label class="block col-span-2">
              <span class="block text-[10px] font-semibold text-gray-500 mb-0.5">Daily time window</span>
              <input type="text" name="rol_time_window" value="<%= sub.rol_time_window || '' %>" placeholder="e.g. 07:00–17:00" class="w-full px-2 py-1 text-xs border border-gray-300 rounded">
            </label>
          </div>
          <div class="flex items-center justify-between gap-2">
            <label class="inline-flex items-center gap-1.5 text-xs text-gray-700">
              <input type="checkbox" name="mark_approved" value="1" <%= rolApproved ? 'checked' : '' %> class="rounded border-gray-300 text-emerald-600">
              Mark approved
            </label>
            <button class="px-2.5 py-1 text-xs font-semibold text-white bg-brand-600 hover:bg-brand-700 rounded-md">Save ROL</button>
          </div>
        </form>
        <form method="POST" action="/compliance/sub-plans/<%= sub.id %>/rola/parse" enctype="multipart/form-data" class="flex items-center gap-1.5">
          <%- include('../partials/csrf') %>
          <span class="text-[11px] text-gray-500">ROLA application PDF:</span>
          <input type="file" name="rola_file" accept=".pdf" required class="text-[11px]">
          <button class="px-2.5 py-1 text-xs font-medium text-white bg-brand-600 hover:bg-brand-700 rounded-md whitespace-nowrap">Read ROLA</button>
        </form>
        <% if (sub.rola_application_number || sub.rol_actual_number || sub.rol_summary_from) { %>
          <div class="grid grid-cols-2 sm:grid-cols-3 gap-2 text-xs">
            <% if (sub.rola_application_number) { %><div><span class="text-gray-400">ROLA #</span> <%= sub.rola_application_number %></div><% } %>
            <% if (sub.rol_actual_number) { %><div><span class="text-gray-400">ROL #</span> <%= sub.rol_actual_number %></div><% } %>
            <% if (sub.rol_summary_from) { %><div><span class="text-gray-400">Range</span> <%= sub.rol_summary_from %> → <%= sub.rol_summary_to || '' %></div><% } %>
            <% if (sub.rol_time_window) { %><div><span class="text-gray-400">Times</span> <%= sub.rol_time_window %></div><% } %>
          </div>
        <% } %>
        <% if (cShifts.length) { %>
          <div class="max-h-40 overflow-y-auto border border-gray-200 rounded bg-white">
            <table class="w-full text-[11px]"><tbody>
              <% cShifts.forEach(s => { %><tr class="border-b border-gray-50"><td class="px-2 py-0.5"><%= s.start_date %> <%= s.start_time %></td><td class="px-2 py-0.5 text-gray-400">→</td><td class="px-2 py-0.5"><%= s.end_date %> <%= s.end_time %></td></tr><% }) %>
            </tbody></table>
          </div>
        <% } %>
      </div>
    </details>
  <% } %>

  <!-- Council permit — permit name + application date up top, JOB START in
       bold, then only the action the current stage needs. -->
  <% if (isCouncilType) {
       const councilApplied = ['submitted', 'approved'].includes(sub.status);
       const councilApproved = sub.status === 'approved';
       const councilDesc = sub.description || '';
       const permitName = councilDesc || sub.council_plan_type || 'Council permit';
       const councilSubmitted = sub.submitted_date || '';
       const councilJob = sub.job_date || '';
       const councilTodayStr = new Date().toISOString().slice(0, 10);
  %>
    <div class="mb-3 flex items-center justify-between gap-3 flex-wrap px-3.5 py-2.5 bg-amber-50/60 ring-1 ring-amber-100 rounded-lg">
      <div class="min-w-0">
        <p class="text-sm font-semibold text-gray-900 truncate" title="<%= permitName %>"><%= permitName %></p>
        <p class="text-[11px] text-gray-500 mt-0.5">
          <%= councilApplied ? ('Applied ' + (councilSubmitted || '—')) : 'Not applied yet' %><%
            %><%= councilApproved && sub.approved_date ? ' · Approved ' + sub.approved_date : '' %><%
            %><% if (sub.application_ref_no) { %> · Ref <%= sub.application_ref_no %><% } %>
        </p>
        <% if (councilApplied && !sub.application_ref_no) { %>
          <form method="POST" action="/compliance/sub-plans/<%= sub.id %>/app-ref" class="mt-1"
            onsubmit="return window.__subPlanAjaxSave(event, this);" data-ajax-save>
            <%- include('../partials/csrf') %>
            <input type="text" name="application_ref_no" placeholder="council ref no. — saves on blur"
              onchange="window.__subPlanAjaxSave(null, this.form);"
              class="w-44 px-2 py-1 text-[11px] bg-white border border-gray-300 rounded focus:outline-none focus:ring-2 focus:ring-brand-500">
          </form>
        <% } %>
      </div>
      <div class="text-right shrink-0">
        <p class="text-[10px] font-bold uppercase tracking-wide text-amber-700">Job start</p>
        <p class="text-base font-bold text-gray-900 leading-tight"><%= councilJob || '—' %></p>
      </div>
    </div>

    <div class="mb-3">
      <% if (!councilApplied) { %>
        <form method="POST" action="/compliance/sub-plans/<%= sub.id %>/council" enctype="multipart/form-data" class="space-y-2.5 p-3 bg-gray-50 rounded-lg">
          <%- include('../partials/csrf') %>
          <input type="hidden" name="action" value="apply">
          <div>
            <label class="block text-[10px] font-semibold uppercase tracking-wide text-gray-500 mb-1">Permit name <span class="text-rose-500">*</span></label>
            <input type="text" name="description" required value="<%= councilDesc %>" placeholder="e.g. Road Opening Permit — 2 lanes northbound"
              class="w-full px-2.5 py-1.5 text-xs bg-white border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-brand-500">
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-2.5">
            <div>
              <label class="block text-[10px] font-semibold uppercase tracking-wide text-gray-500 mb-1">Application date <span class="text-rose-500">*</span></label>
              <input type="date" name="submitted_date" required value="<%= councilSubmitted || councilTodayStr %>"
                class="w-full px-2.5 py-1.5 text-xs bg-white border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-brand-500">
            </div>
            <div>
              <label class="block text-[10px] font-semibold uppercase tracking-wide text-gray-500 mb-1">Job start <span class="text-rose-500">*</span></label>
              <input type="date" name="job_date" required value="<%= councilJob %>"
                class="w-full px-2.5 py-1.5 text-xs bg-white border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-brand-500">
            </div>
            <div>
              <label class="block text-[10px] font-semibold uppercase tracking-wide text-gray-500 mb-1">Council ref <span class="normal-case font-normal">(optional)</span></label>
              <input type="text" name="application_ref_no" value="<%= sub.application_ref_no || '' %>" placeholder="if issued"
                class="w-full px-2.5 py-1.5 text-xs bg-white border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-brand-500">
            </div>
          </div>
          <div class="flex items-center justify-between gap-2 flex-wrap">
            <label class="text-[11px] text-gray-500 inline-flex items-center gap-1.5 cursor-pointer">
              <input type="file" name="documents" multiple accept=".pdf,.doc,.docx,.xls,.xlsx,.csv,.txt,.jpg,.jpeg,.png,.gif,.webp,.dwg,.dxf"
                class="text-[11px] text-gray-600 file:mr-2 file:py-1 file:px-2.5 file:rounded file:border-0 file:text-[11px] file:font-medium file:bg-white file:text-gray-700 file:ring-1 file:ring-gray-300">
            </label>
            <button type="submit" class="px-3 py-1.5 text-xs font-semibold text-white bg-brand-600 hover:bg-brand-700 rounded-md whitespace-nowrap">Mark as applied</button>
          </div>
        </form>
      <% } else if (!councilApproved) { %>
        <form method="POST" action="/compliance/sub-plans/<%= sub.id %>/council" enctype="multipart/form-data" class="space-y-2 p-3 bg-gray-50 rounded-lg">
          <%- include('../partials/csrf') %>
          <input type="hidden" name="action" value="approve">
          <div data-dropzone>
            <input type="file" name="documents" multiple accept=".pdf,.doc,.docx,.xls,.xlsx,.csv,.txt,.jpg,.jpeg,.png,.gif,.webp,.dwg,.dxf">
            <div class="dropzone-label">
              <p class="text-xs text-gray-500">Drop the approved permit here or <span class="text-brand-600 font-medium">browse</span> <span class="text-gray-400">(optional)</span></p>
            </div>
          </div>
          <div class="flex items-center justify-end">
            <button type="submit" class="px-3 py-1.5 text-xs font-semibold text-white bg-emerald-600 hover:bg-emerald-700 rounded-md whitespace-nowrap">Mark as approved</button>
          </div>
        </form>
      <% } else { %>
        <form method="POST" action="/compliance/sub-plans/<%= sub.id %>/council" enctype="multipart/form-data">
          <%- include('../partials/csrf') %>
          <input type="hidden" name="action" value="approve">
          <div class="flex items-center gap-2 flex-wrap text-xs">
            <input type="file" name="documents" multiple accept=".pdf,.doc,.docx,.xls,.xlsx,.csv,.txt,.jpg,.jpeg,.png,.gif,.webp,.dwg,.dxf"
              class="flex-1 min-w-[180px] text-xs text-gray-700 file:mr-3 file:py-1.5 file:px-3 file:rounded file:border-0 file:text-xs file:font-medium file:bg-brand-50 file:text-brand-700 hover:file:bg-brand-100">
            <button type="submit" class="px-3 py-1.5 text-xs font-medium text-gray-700 bg-gray-100 hover:bg-gray-200 rounded-md whitespace-nowrap">Attach file</button>
          </div>
        </form>
      <% } %>
    </div>

    <!-- Council fees (itemised, with receipts) — council permits only -->
    <details class="mb-3 group">
      <summary class="cursor-pointer text-xs font-medium text-brand-600 hover:text-brand-700 inline-flex items-center list-none">
        <svg class="w-3.5 h-3.5 mr-1 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
        Council fees<% if (cFees.length) { %> · <%= cFees.length %> ($<%= feesTotal.toFixed(2) %>)<% } %>
      </summary>
      <div class="mt-2 p-3 bg-gray-50 rounded-md space-y-2">
        <% cFees.forEach(f => { %>
          <div class="flex items-center justify-between gap-2 text-xs">
            <span class="text-gray-800"><%= f.description || '—' %> · <span class="font-medium">$<%= (parseFloat(f.amount)||0).toFixed(2) %></span><% if (f.receipt_file_path) { %> · <a href="<%= f.receipt_file_path %>" target="_blank" class="text-brand-600 hover:underline"><%= f.receipt_original_name || 'receipt' %></a><% } %></span>
            <form method="POST" action="/compliance/sub-plans/<%= sub.id %>/fees/<%= f.id %>/delete" onsubmit="return confirm('Delete this fee?')"><%- include('../partials/csrf') %><button class="text-gray-400 hover:text-rose-600">✕</button></form>
          </div>
        <% }) %>
        <form method="POST" action="/compliance/sub-plans/<%= sub.id %>/fees" enctype="multipart/form-data" class="grid grid-cols-1 sm:grid-cols-4 gap-2 items-end pt-1">
          <%- include('../partials/csrf') %>
          <input type="text" name="description" placeholder="Description" class="sm:col-span-2 px-2.5 py-1.5 text-xs bg-white border border-gray-300 rounded-md">
          <input type="number" step="0.01" min="0" name="amount" placeholder="Amount ($)" class="px-2.5 py-1.5 text-xs bg-white border border-gray-300 rounded-md">
          <input type="file" name="receipt" accept=".pdf,.jpg,.jpeg,.png,.webp" class="text-[11px]">
          <div class="sm:col-span-4"><button class="px-3 py-1.5 text-xs font-medium text-white bg-brand-600 hover:bg-brand-700 rounded-md">Add fee</button></div>
        </form>
      </div>
    </details>

    <!-- Council extensions: chips + "+ Extension" -->
    <div class="mb-3 px-3 py-2 bg-amber-50/50 ring-1 ring-amber-100 rounded text-xs">
      <div class="flex items-center gap-2 flex-wrap">
        <span class="text-[10px] font-bold uppercase tracking-wide text-amber-700">Extensions</span>
        <% cExt.forEach(e => { %>
          <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded bg-white ring-1 ring-amber-200 text-amber-800 text-[11px] font-medium" title="<%= e.reason || '' %>">
            <%= e.label || 'Extension' %><%= e.extended_to ? ' → ' + e.extended_to : '' %>
            <% if (e.file_path) { %><a href="<%= e.file_path %>" target="_blank" class="text-brand-600 hover:underline">file</a><% } %>
            <form method="POST" action="/compliance/sub-plans/<%= sub.id %>/extensions/<%= e.id %>/delete" class="inline" onsubmit="return confirm('Delete this extension?')"><%- include('../partials/csrf') %><button class="text-gray-400 hover:text-rose-600 leading-none">✕</button></form>
          </span>
        <% }) %>
        <button type="button" class="px-2 py-0.5 text-[11px] font-semibold text-amber-700 bg-white hover:bg-amber-100 ring-1 ring-amber-300 rounded"
          onclick="var f=document.getElementById('ext-form-<%= sub.id %>'); f.classList.toggle('hidden'); if(!f.classList.contains('hidden'))f.querySelector('input[type=date]').focus();">+ Extension</button>
      </div>
      <form method="POST" action="/compliance/sub-plans/<%= sub.id %>/extensions" enctype="multipart/form-data" id="ext-form-<%= sub.id %>" class="hidden mt-2 flex flex-wrap items-center gap-2">
        <%- include('../partials/csrf') %>
        <label class="text-[11px] text-gray-600">Extended to <input type="date" name="extended_to" required class="ml-1 px-2 py-1 text-xs border border-gray-300 rounded"></label>
        <input type="text" name="reason" placeholder="Reason (optional)" class="flex-1 min-w-[120px] px-2 py-1 text-xs border border-gray-300 rounded">
        <input type="file" name="extension_file" accept=".pdf,.jpg,.jpeg,.png,.webp" class="text-[11px]">
        <button class="px-2.5 py-1 text-[11px] font-semibold text-white bg-amber-600 hover:bg-amber-700 rounded">Add</button>
      </form>
    </div>
  <% } %>

  <!-- Legacy safety valve: fees recorded on a non-council sub-plan stay
       visible (read-only) even though the Fees form is council-only now. -->
  <% if (!isCouncilType && cFees.length) { %>
    <p class="mb-3 text-[11px] text-gray-500">Fees recorded on this sub-plan · $<%= feesTotal.toFixed(2) %><% cFees.forEach(f => { %> · <%= f.description || 'fee' %> $<%= (parseFloat(f.amount)||0).toFixed(2) %><% }) %></p>
  <% } %>

  <!-- Upload + submit — NOT for ROL (the issued-PDF auto flow replaces it)
       and NOT for council (the apply/approve flow above is the whole
       lifecycle — a second submit path was just noise). -->
  <% const submitOpen = !isSubmitted && !isCouncilType && !isRolType; %>
  <% if (!isApproved && !isRejected && !isRolType && !isCouncilType) { %>
    <details class="group" <%= submitOpen ? 'open' : '' %>>
      <summary class="cursor-pointer text-xs font-semibold text-brand-700 hover:text-brand-800 inline-flex items-center list-none px-2.5 py-1.5 -ml-1 rounded-md bg-brand-50 ring-1 ring-brand-100">
        <svg class="w-3.5 h-3.5 mr-1 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
        <%= isSubmitted ? 'Re-submit plan…' : 'Submit plan' %>
        <% if (!isSubmitted) { %><span class="ml-1.5 font-normal text-brand-600/80">— upload the plan here to lodge it</span><% } %>
      </summary>
      <form method="POST" action="/compliance/sub-plans/<%= sub.id %>/upload-submit" enctype="multipart/form-data" class="mt-3 grid grid-cols-1 sm:grid-cols-2 gap-3 p-3 bg-gray-50 rounded-md">
        <%- include('../partials/csrf') %>

        <div class="sm:col-span-2">
          <label class="block text-xs font-medium text-gray-700 mb-1">Description <span class="text-rose-500">*</span></label>
          <input type="text" name="description" required
            value="<%= sub.description || '' %>"
            placeholder="e.g. Northbound 2 lanes"
            class="w-full px-2.5 py-1.5 text-xs bg-white border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-brand-500">
        </div>

        <% const fileRequired = docCount === 0 && sub.item_type !== 'council_permit'; %>
        <div class="sm:col-span-2">
          <label class="block text-xs font-medium text-gray-700 mb-1">Files <% if (fileRequired) { %><span class="text-rose-500">*</span><% } %></label>
          <div data-dropzone>
            <input type="file" name="documents" multiple <%= fileRequired ? 'required' : '' %>
              accept=".pdf,.doc,.docx,.xls,.xlsx,.csv,.txt,.jpg,.jpeg,.png,.gif,.webp,.dwg,.dxf">
            <div class="dropzone-label">
              <p class="text-xs text-gray-500">Drag &amp; drop or <span class="text-brand-600 font-medium">click to browse</span></p>
            </div>
          </div>
          <p class="mt-1 text-[11px] text-gray-500">PDF, Word, Excel, images, DWG/DXF — max 25MB / 10 files<% if (!fileRequired && docCount > 0) { %> · optional, <%= docCount %> file<%= docCount > 1 ? 's' : '' %> already attached<% } else if (sub.item_type === 'council_permit') { %> · optional for council<% } %></p>
        </div>

        <% const jobMandatory = (sub.item_type === 'council_permit'); %>
        <div>
          <label class="block text-xs font-medium text-gray-700 mb-1">Client request date</label>
          <input type="date" name="client_request_date" value="<%= sub.client_request_date || '' %>"
            class="w-full px-2.5 py-1.5 text-xs bg-white border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-brand-500">
        </div>
        <div>
          <label class="block text-xs font-medium text-gray-700 mb-1">Submission date <span class="text-rose-500">*</span></label>
          <input type="date" name="submitted_date" required
            value="<%= sub.submitted_date || new Date().toISOString().slice(0, 10) %>"
            class="w-full px-2.5 py-1.5 text-xs bg-white border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-brand-500">
        </div>
        <% if (jobMandatory) { %>
        <div>
          <label class="block text-xs font-medium text-gray-700 mb-1">Job start <span class="text-rose-500">*</span></label>
          <input type="date" name="job_date" value="<%= sub.job_date || '' %>" required
            class="w-full px-2.5 py-1.5 text-xs bg-white border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-brand-500">
        </div>
        <% } %>
        <% if (sub.item_type === 'council_permit') { %>
        <div>
          <label class="block text-xs font-medium text-gray-700 mb-1">Type of Council Plan</label>
          <input type="text" name="council_plan_type" value="<%= sub.council_plan_type || '' %>"
            placeholder="e.g. Road Opening Permit"
            class="w-full px-2.5 py-1.5 text-xs bg-white border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-brand-500">
        </div>
        <% } %>

        <div class="sm:col-span-2">
          <label class="block text-xs font-medium text-gray-700 mb-1">Comments</label>
          <textarea name="notes" rows="2"
            class="w-full px-2.5 py-1.5 text-xs bg-white border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-brand-500"><%= sub.notes || '' %></textarea>
        </div>

        <div class="sm:col-span-2 pt-3 border-t border-gray-200">
          <label class="block text-xs font-medium text-gray-700 mb-1">Hours spent <span class="text-rose-500">*</span></label>
          <input type="number" name="hours_spent" required min="0.25" step="0.25" value="<%= sub.hours_spent || '' %>"
            placeholder="0.5"
            class="w-32 px-2.5 py-1.5 text-xs bg-white border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-brand-500">
        </div>

        <%- include('../partials/notify-picker') %>

        <div class="sm:col-span-2 flex items-center justify-end">
          <button type="submit" class="px-3 py-1.5 text-xs font-medium text-white bg-brand-600 hover:bg-brand-700 rounded-md">
            Upload & Submit
          </button>
        </div>
      </form>
    </details>
  <% } %>

  <!-- Supporting documents — attach-only; never changes status. -->
  <div class="mt-3">
    <p class="text-[10px] font-bold uppercase tracking-wide text-gray-500 mb-1.5">Supporting documents<% if (docCount > 0) { %> · <%= docCount %><% } %></p>
    <% if (docCount > 0) { %>
    <div class="mb-2 space-y-1">
      <% docs.forEach(d => { %>
        <div class="flex items-center justify-between gap-2 px-2 py-1.5 bg-gray-50 rounded text-xs">
          <a href="<%= d.file_path %>" target="_blank" class="flex-1 truncate text-brand-600 hover:text-brand-700">
            <%= d.original_name %>
          </a>
          <span class="text-gray-400 shrink-0"><%= Math.round((d.file_size || 0) / 1024) %> KB</span>
          <form method="POST" action="/compliance/<%= sub.id %>/documents/<%= d.id %>/delete" class="inline shrink-0" onsubmit="return confirm('Delete this file?')">
            <%- include('../partials/csrf') %>
            <input type="hidden" name="return_to" value="/compliance/<%= parentId %>/edit#sub-<%= sub.id %>">
            <button type="submit" class="text-gray-400 hover:text-rose-600 p-0.5">
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
            </button>
          </form>
        </div>
      <% }) %>
    </div>
    <% } %>
    <form method="POST" action="/compliance/sub-plans/<%= sub.id %>/documents" enctype="multipart/form-data" data-attach-form>
      <%- include('../partials/csrf') %>
      <div data-dropzone>
        <input type="file" name="documents" multiple accept=".pdf,.doc,.docx,.xls,.xlsx,.csv,.txt,.jpg,.jpeg,.png,.gif,.webp,.dwg,.dxf">
        <div class="dropzone-label">
          <p class="text-xs text-gray-500">Drag &amp; drop supporting files — or <span class="text-brand-600 font-medium">click to browse</span></p>
          <p class="text-[11px] text-gray-400 mt-0.5">Extras only — this does <span class="font-semibold">not</span> <%= isRolType ? 'approve the ROL (use the issued-ROL zone above)' : 'submit the plan' %>. Max 25MB / 10 files.</p>
        </div>
      </div>
      <noscript><button type="submit" class="mt-1.5 px-3 py-1.5 text-xs font-medium text-gray-700 bg-gray-100 hover:bg-gray-200 rounded-md">Attach</button></noscript>
    </form>
  </div>
  </div><%# /accordion body %>
</details>
