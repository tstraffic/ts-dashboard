<%
  const isEdit = !!item;
  const formAction = isEdit ? '/compliance/' + item.id : '/compliance';
  const pageTitle = isEdit ? 'Edit Plan' : 'New Plan';
  const cancelHref = (typeof returnTo !== 'undefined' && returnTo) ? returnTo : '/compliance';

  const TYPE_LABELS = {
    traffic_guidance:    'TGS (Traffic Guidance Scheme)',
    tmp_approval:        'CTMP (Construction Traffic Mgmt Plan)',
    spa:                 'SPA (Swept Path Analysis)',
    sza:                 'SZA (Speed Zone Authorisation)',
    rol:                 'ROL (Road Occupancy Licence)',
    council_permit:      'Council Permit',
    bus_approval:        'Bus Approval',
    police_notification: 'Police Notification',
    letter_drop:         'Letter Drop',
    other:               'Other',
  };

  const STATUS_BADGE = {
    not_started: 'bg-gray-100 text-gray-700 ring-gray-200',
    started:     'bg-amber-50 text-amber-700 ring-amber-200',
    submitted:   'bg-blue-50 text-blue-700 ring-blue-200',
    approved:    'bg-emerald-50 text-emerald-700 ring-emerald-200',
    rejected:    'bg-rose-50 text-rose-700 ring-rose-200',
    expired:     'bg-orange-50 text-orange-700 ring-orange-200',
  };

  // Group sub-plans by item_type so we can render a section per type.
  const groupedSubPlans = {};
  (subPlans || []).forEach(s => {
    (groupedSubPlans[s.item_type] = groupedSubPlans[s.item_type] || []).push(s);
  });
  // ROL sub-plans of this plan — passed to every card so a TGS can offer a
  // "Linked ROL" dropdown listing the ROLs on the same plan.
  const rolSubs = (subPlans || []).filter(s => s.item_type === 'rol' || s.item_type === 'road_occupancy');
  const tgsSubs = (subPlans || []).filter(s => s.item_type === 'traffic_guidance');

  const planNumber = isEdit ? item.plan_number : null;
%>

<div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
  <div class="mb-6">
    <a href="<%= cancelHref %>" class="inline-flex items-center text-sm text-gray-500 hover:text-gray-700 mb-3">
      <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
      Back
    </a>
    <div class="flex items-center justify-between flex-wrap gap-2">
      <h1 class="text-2xl font-bold text-gray-900"><%= pageTitle %><% if (isEdit) { %> <span class="text-gray-400 font-mono text-lg">#<%= planNumber %></span><% } %></h1>
      <div class="flex items-center gap-2 flex-wrap">
        <% if (isEdit && typeof tender !== 'undefined' && tender) { %>
          <a href="/tenders/<%= tender.id %>" class="inline-flex items-center gap-1 px-2.5 py-1 rounded-md text-xs font-semibold bg-purple-50 text-purple-700 ring-1 ring-purple-600/20 hover:bg-purple-100">
            <svg class="w-3 h-3" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z"/></svg>
            Tender <%= tender.tender_number %>
          </a>
        <% } %>
        <% if (isEdit) { %>
          <span class="inline-flex items-center px-2.5 py-1 rounded-md text-xs font-medium ring-1 ring-inset <%= STATUS_BADGE[item.status] || STATUS_BADGE.not_started %>">
            <%= (item.status || 'not_started').replace(/_/g, ' ') %>
          </span>
          <span id="plan-autosave-status" class="inline-flex items-center gap-1.5 text-xs font-medium text-gray-400" aria-live="polite">
            <svg class="w-3.5 h-3.5 text-emerald-500" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
            <span data-autosave-text>All changes saved</span>
          </span>
        <% } %>
      </div>
    </div>
  </div>

  <!-- Parent fields form -->
  <form method="POST" action="<%= formAction %>" id="planForm" class="bg-white border border-gray-200 rounded-xl shadow-sm p-6 mb-6">
    <%- include('../partials/csrf') %>
    <input type="hidden" name="return_to" value="<%= cancelHref %>">
    <% if (!isEdit) { %><input type="hidden" name="is_parent" value="1"><% } %>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <div class="md:col-span-2">
        <label for="title" class="block text-sm font-medium text-gray-700 mb-1.5">
          Site address <span class="text-rose-500">*</span>
          <span class="ml-1.5 text-xs font-normal text-gray-400">becomes the plan name</span>
        </label>
        <div class="relative">
          <svg class="w-5 h-5 text-gray-400 absolute left-3 top-1/2 -translate-y-1/2 pointer-events-none" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
          <input type="text" id="title" name="title" required autocomplete="off"
            value="<%= isEdit ? (item.title || '') : '' %>"
            placeholder="Start typing the site address…"
            data-addr-autocomplete
            class="w-full pl-10 pr-3 py-2.5 bg-white border border-gray-300 rounded-lg text-base focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-brand-500">
        </div>
        <%# Structured location filled by the picker; empty when the title was
            typed free-hand. Persisted by createParentPlan / the parent-save
            branch (migration 350 columns). %>
        <input type="hidden" name="site_address" value="<%= isEdit ? (item.site_address || '') : '' %>">
        <input type="hidden" name="suburb"       value="<%= isEdit ? (item.suburb || '') : '' %>">
        <input type="hidden" name="state"        value="<%= isEdit ? (item.state || '') : '' %>">
        <input type="hidden" name="postcode"     value="<%= isEdit ? (item.postcode || '') : '' %>">
        <input type="hidden" name="latitude"     value="<%= isEdit && item.latitude != null ? item.latitude : '' %>">
        <input type="hidden" name="longitude"    value="<%= isEdit && item.longitude != null ? item.longitude : '' %>">
        <p id="addrStatus" class="mt-1.5 text-xs <%= isEdit && item.latitude != null ? 'text-emerald-600 font-medium' : 'text-gray-400' %>">
          <% if (isEdit && item.latitude != null) { %>
            ✓ Located · <%= [item.suburb, item.state, item.postcode].filter(Boolean).join(' ') %>
          <% } else { %>
            Pick a suggestion to pin the location — or just type any plan name.
          <% } %>
        </p>
      </div>

      <div>
        <div class="flex items-center justify-between mb-1.5">
          <label for="job_id" class="block text-sm font-medium text-gray-700">Project / Job</label>
          <button type="button" data-qa-toggle="job" class="text-[11px] font-medium text-brand-600 hover:text-brand-700">+ New job</button>
        </div>
        <select id="job_id" name="job_id"
          class="w-full px-3 py-2 bg-white border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-brand-500">
          <option value="">— None —</option>
          <% jobs.forEach(j => { %>
            <option value="<%= j.id %>" <%= (isEdit && item.job_id == j.id) || (!isEdit && prefillJobId == j.id) ? 'selected' : '' %>>
              <%= j.job_number %> — <%= [j.project_name, j.client].filter(Boolean).join(' · ') %>
            </option>
          <% }) %>
        </select>
        <div data-qa-panel="job" class="hidden mt-2 p-3 bg-brand-50 border border-brand-200 rounded-lg space-y-2">
          <input type="text" data-qa-field="project_name" placeholder="Project name" maxlength="200"
            class="w-full px-2.5 py-1.5 bg-white border border-gray-300 rounded-md text-sm focus:outline-none focus:ring-2 focus:ring-brand-500">
          <p class="text-[11px] text-brand-700/70">Uses the site address above and the selected client. Number auto-assigned (J-XXXX).</p>
          <div class="flex items-center gap-2">
            <button type="button" data-qa-save="job" class="px-3 py-1.5 bg-brand-600 hover:bg-brand-500 text-white text-xs font-semibold rounded-md transition">Create job</button>
            <button type="button" data-qa-cancel="job" class="text-xs text-gray-400 hover:text-gray-600">Cancel</button>
            <span data-qa-msg="job" class="text-[11px] text-gray-500"></span>
          </div>
        </div>
      </div>

      <% var tendersList = (typeof tenders !== 'undefined' && Array.isArray(tenders)) ? tenders : [];
         var prefillTender = (typeof prefillTenderId !== 'undefined') ? prefillTenderId : ''; %>
      <div>
        <div class="flex items-center justify-between mb-1.5">
          <label for="tender_id" class="block text-sm font-medium text-gray-700">Tender <span class="text-gray-400 font-normal">(optional)</span></label>
          <% if (canAccess(user, 'tenders')) { %>
            <button type="button" data-qa-toggle="tender" class="text-[11px] font-medium text-brand-600 hover:text-brand-700">+ New tender</button>
          <% } %>
        </div>
        <select id="tender_id" name="tender_id"
          class="w-full px-3 py-2 bg-white border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-brand-500">
          <option value="">— None —</option>
          <% tendersList.forEach(t => { %>
            <option value="<%= t.id %>" <%= (isEdit && item.tender_id == t.id) || (!isEdit && String(prefillTender) === String(t.id)) ? 'selected' : '' %>>
              <%= t.tender_number %> — <%= t.title %>
            </option>
          <% }) %>
        </select>
        <% if (canAccess(user, 'tenders')) { %>
          <div data-qa-panel="tender" class="hidden mt-2 p-3 bg-brand-50 border border-brand-200 rounded-lg space-y-2">
            <input type="text" data-qa-field="tender_title" placeholder="Tender title" maxlength="200"
              class="w-full px-2.5 py-1.5 bg-white border border-gray-300 rounded-md text-sm focus:outline-none focus:ring-2 focus:ring-brand-500">
            <p class="text-[11px] text-brand-700/70">Carries the site address and selected client. Number auto-assigned (TND-YYYY-###).</p>
            <div class="flex items-center gap-2">
              <button type="button" data-qa-save="tender" class="px-3 py-1.5 bg-brand-600 hover:bg-brand-500 text-white text-xs font-semibold rounded-md transition">Create tender</button>
              <button type="button" data-qa-cancel="tender" class="text-xs text-gray-400 hover:text-gray-600">Cancel</button>
              <span data-qa-msg="tender" class="text-[11px] text-gray-500"></span>
            </div>
          </div>
        <% } %>
      </div>

      <div>
        <div class="flex items-center justify-between mb-1.5">
          <label for="client_id" class="block text-sm font-medium text-gray-700">Client</label>
          <button type="button" data-qa-toggle="client" class="text-[11px] font-medium text-brand-600 hover:text-brand-700">+ New client</button>
        </div>
        <select id="client_id" name="client_id"
          class="w-full px-3 py-2 bg-white border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-brand-500">
          <option value="">— None —</option>
          <% clients.forEach(c => { %>
            <option value="<%= c.id %>" <%= (isEdit && item.client_id == c.id) || (!isEdit && prefillClientId == c.id) ? 'selected' : '' %>>
              <%= c.company_name %>
            </option>
          <% }) %>
        </select>
        <div data-qa-panel="client" class="hidden mt-2 p-3 bg-brand-50 border border-brand-200 rounded-lg space-y-2">
          <input type="text" data-qa-field="company_name" placeholder="Company name" maxlength="200"
            class="w-full px-2.5 py-1.5 bg-white border border-gray-300 rounded-md text-sm focus:outline-none focus:ring-2 focus:ring-brand-500">
          <div class="flex items-center gap-2">
            <button type="button" data-qa-save="client" class="px-3 py-1.5 bg-brand-600 hover:bg-brand-500 text-white text-xs font-semibold rounded-md transition">Create client</button>
            <button type="button" data-qa-cancel="client" class="text-xs text-gray-400 hover:text-gray-600">Cancel</button>
            <span data-qa-msg="client" class="text-[11px] text-gray-500"></span>
          </div>
        </div>
      </div>

      <% const canInvitePm = ['admin', 'management'].includes(String(user.role || '').toLowerCase()); %>
      <div>
        <div class="flex items-center justify-between mb-1.5">
          <label for="pm_id" class="block text-sm font-medium text-gray-700">Project PM</label>
          <% if (canInvitePm) { %>
            <button type="button" data-qa-toggle="pm" class="text-[11px] font-medium text-brand-600 hover:text-brand-700">+ Invite user</button>
          <% } %>
        </div>
        <select id="pm_id" name="pm_id"
          class="w-full px-3 py-2 bg-white border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-brand-500">
          <option value="">— Unassigned —</option>
          <% users.forEach(u => { %>
            <option value="<%= u.id %>" <%= (isEdit && item.assigned_to_id == u.id) ? 'selected' : '' %>><%= u.full_name %></option>
          <% }) %>
        </select>
        <% if (canInvitePm) { %>
          <div data-qa-panel="pm" class="hidden mt-2 p-3 bg-brand-50 border border-brand-200 rounded-lg space-y-2">
            <input type="text" data-qa-field="pm_name" placeholder="Full name" maxlength="120"
              class="w-full px-2.5 py-1.5 bg-white border border-gray-300 rounded-md text-sm focus:outline-none focus:ring-2 focus:ring-brand-500">
            <input type="email" data-qa-field="pm_email" placeholder="Email address" maxlength="200"
              class="w-full px-2.5 py-1.5 bg-white border border-gray-300 rounded-md text-sm focus:outline-none focus:ring-2 focus:ring-brand-500">
            <select data-qa-field="pm_role"
              class="w-full px-2.5 py-1.5 bg-white border border-gray-300 rounded-md text-sm focus:outline-none focus:ring-2 focus:ring-brand-500">
              <option value="planning" selected>Planning</option>
              <option value="operations">Operations</option>
              <option value="management">Management</option>
              <option value="finance">Finance</option>
            </select>
            <p class="text-[11px] text-brand-700/70">They're emailed an invitation to set a password, and are assignable right away.</p>
            <div class="flex items-center gap-2">
              <button type="button" data-qa-save="pm" class="px-3 py-1.5 bg-brand-600 hover:bg-brand-500 text-white text-xs font-semibold rounded-md transition">Send invite</button>
              <button type="button" data-qa-cancel="pm" class="text-xs text-gray-400 hover:text-gray-600">Cancel</button>
              <span data-qa-msg="pm" class="text-[11px] text-gray-500"></span>
            </div>
          </div>
        <% } %>
      </div>

      <div>
        <label for="client_request_date" class="block text-sm font-medium text-gray-700 mb-1.5">Client Request Date</label>
        <input type="date" id="client_request_date" name="client_request_date"
          value="<%= isEdit ? (item.client_request_date || '') : '' %>"
          class="w-full px-3 py-2 bg-white border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-brand-500">
      </div>

      <div class="md:col-span-2">
        <label for="notes" class="block text-sm font-medium text-gray-700 mb-1.5">Plan Notes</label>
        <textarea id="notes" name="notes" rows="2"
          class="w-full px-3 py-2 bg-white border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-brand-500"><%= isEdit ? (item.notes || '') : '' %></textarea>
      </div>

      <% if (!isEdit) { %>
        <%- include('../partials/notify-picker') %>
      <% } %>
    </div>

    <% if (!isEdit) { %>
      <!-- Type & quantity grid (create only). Tick a type, set how many,
           and pick an owner — each sub-plan of that type lands assigned
           to the chosen user. -->
      <div class="mt-6 pt-6 border-t border-gray-200">
        <h2 class="text-sm font-semibold text-gray-900 mb-1">Sub-plans to generate</h2>
        <p class="text-sm text-gray-500 mb-4">Tick each type you need and set how many. Each one becomes its own slot with a system reference (e.g. <code class="px-1.5 py-0.5 bg-gray-100 rounded">TSTGS3100</code>; additional ones in the same group get <code class="px-1.5 py-0.5 bg-gray-100 rounded">-2</code>, <code class="px-1.5 py-0.5 bg-gray-100 rounded">-3</code>, …) you can name and upload to.</p>
        <!-- One owner for everything by default (mirrors the Project PM until
             touched); the per-type owner selects only appear when the planner
             genuinely wants different owners per type. Disabled inputs don't
             post, so the server-side fallback chain stays simple. -->
        <div class="mb-4 flex flex-wrap items-end gap-4">
          <div>
            <label class="block text-xs font-medium text-gray-700 mb-1">Default sub-plan owner</label>
            <select name="default_owner_id" id="defaultOwnerSelect" class="px-2.5 py-1.5 text-sm bg-white border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-brand-500">
              <option value="">— Unassigned —</option>
              <% users.forEach(u => { %><option value="<%= u.id %>"><%= u.full_name %></option><% }) %>
            </select>
          </div>
          <label class="flex items-center gap-1.5 text-xs text-gray-600 pb-2 cursor-pointer">
            <input type="checkbox" id="customiseOwners" class="w-4 h-4 rounded border-gray-300 text-brand-600 focus:ring-brand-500">
            Customise owner per type
          </label>
        </div>
        <div class="space-y-2.5">
          <% subPlanTypes.forEach(t => { %>
            <div class="border border-gray-200 rounded-lg hover:border-brand-300 hover:bg-brand-50/40 has-[:checked]:border-brand-400 has-[:checked]:bg-brand-50">
              <label class="grid grid-cols-[1fr_auto_auto_minmax(0,200px)] items-center gap-3 px-4 py-3 cursor-pointer">
                <span class="flex items-center gap-2.5 text-sm text-gray-800">
                  <input type="checkbox" class="type-toggle w-4 h-4 rounded border-gray-300 text-brand-600 focus:ring-brand-500" data-type="<%= t %>">
                  <%= TYPE_LABELS[t] || t %>
                </span>
                <% if (t === 'traffic_guidance') { %>
                  <label class="ra-toggle flex items-center gap-1.5 text-[11px] font-medium text-gray-600 whitespace-nowrap opacity-60 cursor-pointer" title="Auto-create a TGS Risk & Options Assessment for each sub-plan">
                    <input type="checkbox" name="ra_needed_<%= t %>" value="1" disabled class="ra-checkbox w-4 h-4 rounded border-gray-300 text-brand-600 focus:ring-brand-500 disabled:cursor-not-allowed">
                    RA needed
                  </label>
                <% } else { %>
                  <span class="text-[11px] text-gray-300 whitespace-nowrap" title="Risk assessments for this type are coming soon">RA n/a</span>
                <% } %>
                <input type="number" name="count_<%= t %>" min="1" max="20" value="1" disabled
                  class="count-input w-16 px-2 py-1 text-sm text-center border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-brand-500 disabled:bg-gray-50 disabled:text-gray-400">
                <select name="owner_<%= t %>" disabled
                  class="owner-input hidden w-full px-2 py-1 text-sm bg-white border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-brand-500 disabled:bg-gray-50 disabled:text-gray-400">
                  <option value="">— Owner —</option>
                  <% users.forEach(u => { %><option value="<%= u.id %>"><%= u.full_name %></option><% }) %>
                </select>
              </label>
              <% if (t === 'other') { %>
                <div class="px-4 pb-3 -mt-1 hidden other-desc-wrap space-y-1.5" id="otherDescList">
                  <p class="text-[11px] text-gray-500">Describe each one — one row per "Other" you're generating.</p>
                  <!-- Description inputs are rendered by JS when count or checkbox changes -->
                </div>
              <% } %>
            </div>
          <% }) %>
        </div>
      </div>
      <script>
        // Toggle: ticking a type enables its count input. The per-type
        // owner select only participates when "Customise owner per type"
        // is on — otherwise it stays hidden AND disabled (disabled inputs
        // aren't submitted), and the server falls back to the default
        // owner, then the PM.
        const customiseOwners = document.getElementById('customiseOwners');
        function syncOwnerInputs() {
          const custom = customiseOwners && customiseOwners.checked;
          document.querySelectorAll('.type-toggle').forEach(cb => {
            const card = cb.closest('.border');
            const owner = card.querySelector('.owner-input');
            if (!owner) return;
            owner.classList.toggle('hidden', !custom);
            owner.disabled = !(custom && cb.checked);
          });
        }
        if (customiseOwners) customiseOwners.addEventListener('change', syncOwnerInputs);

        // Default owner mirrors the Project PM until the user touches it.
        const pmSelect = document.querySelector('select[name="pm_id"]');
        const defaultOwner = document.getElementById('defaultOwnerSelect');
        if (pmSelect && defaultOwner) {
          let ownerTouched = false;
          defaultOwner.addEventListener('change', () => { ownerTouched = true; });
          pmSelect.addEventListener('change', () => {
            if (!ownerTouched) defaultOwner.value = pmSelect.value;
          });
        }

        document.querySelectorAll('.type-toggle').forEach(cb => {
          cb.addEventListener('change', e => {
            const card = e.target.closest('.border');
            const countInput = card.querySelector('.count-input');
            countInput.disabled = !cb.checked;
            syncOwnerInputs();
            // RA-needed checkbox (only present on TGS row) follows the same gate as count + owner.
            const raLabel = card.querySelector('.ra-toggle');
            const raCheckbox = card.querySelector('.ra-checkbox');
            if (raCheckbox) {
              raCheckbox.disabled = !cb.checked;
              if (raLabel) raLabel.classList.toggle('opacity-60', !cb.checked);
              if (!cb.checked) raCheckbox.checked = false;
            }
            if (cb.dataset.type === 'other') {
              renderOtherDescriptions(card, cb.checked);
              if (cb.checked) {
                const first = card.querySelector('.other-desc-row input');
                if (first) first.focus(); else countInput.focus();
                return;
              }
            }
            if (cb.checked) countInput.focus();
          });
        });

        // Other gets one description input per count. When count changes
        // we add/remove rows so each "Other" sub-plan has its own label.
        function renderOtherDescriptions(card, checked) {
          const wrap = card.querySelector('.other-desc-wrap');
          if (!wrap) return;
          wrap.classList.toggle('hidden', !checked);
          if (!checked) { wrap.querySelectorAll('.other-desc-row').forEach(r => r.remove()); return; }
          const count = Math.max(1, parseInt(card.querySelector('.count-input').value, 10) || 1);
          // Preserve current values when re-rendering
          const existing = Array.from(wrap.querySelectorAll('.other-desc-row input')).map(i => i.value);
          wrap.querySelectorAll('.other-desc-row').forEach(r => r.remove());
          for (let i = 1; i <= count; i++) {
            const row = document.createElement('div');
            row.className = 'other-desc-row flex items-center gap-2';
            row.innerHTML = `
              <span class="text-[11px] font-mono text-gray-400 w-6 shrink-0">#${i}</span>
              <input type="text" name="other_description_${i}" maxlength="120"
                placeholder="What is Other #${i}? e.g. RMS letter, environmental approval…"
                class="flex-1 px-3 py-2 text-sm bg-white border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-brand-500" />
            `;
            const input = row.querySelector('input');
            if (existing[i - 1] != null) input.value = existing[i - 1];
            wrap.appendChild(row);
          }
        }

        // Re-render description rows when the "Other" count changes
        document.querySelectorAll('.type-toggle[data-type="other"]').forEach(cb => {
          const card = cb.closest('.border');
          const countInput = card.querySelector('.count-input');
          countInput.addEventListener('input', () => {
            if (cb.checked) renderOtherDescriptions(card, true);
          });
        });
      </script>
    <% } %>
    <% if (!isEdit) { %>
      <!-- Inline submit on create flow (edit flow shows buttons at the bottom of the page) -->
      <div class="mt-6 pt-6 border-t border-gray-200 flex items-center justify-end gap-3">
        <a href="<%= cancelHref %>" class="px-4 py-2 text-sm font-medium text-gray-700 bg-white border border-gray-300 rounded-lg hover:bg-gray-50">Cancel</a>
        <button type="submit" class="px-4 py-2 text-sm font-medium text-white bg-brand-600 hover:bg-brand-700 rounded-lg">Create Plan</button>
      </div>
    <% } %>
  </form>

  <% if (isEdit) {
    // Plan-wide tallies — sums across every sub-plan, regardless of
    // status, so the totals stay visible even before submission.
    let totalHours = 0, totalCharge = 0, totalCouncilFee = 0, submittedCount = 0;
    (subPlans || []).forEach(s => {
      totalHours += parseFloat(s.hours_spent) || 0;
      if (s.charge_client) totalCharge += parseFloat(s.charge_amount) || 0;
      if (s.council_fee_paid) totalCouncilFee += parseFloat(s.council_fee_amount) || 0;
      if (['submitted','approved'].includes(s.status)) submittedCount += 1;
    });
    const fmtMoney = n => '$' + (Math.round(n * 100) / 100).toFixed(2);
    const fmtHours = n => (Math.round(n * 100) / 100) + ' hr' + (n === 1 ? '' : 's');
    // Internal cost / profit — admin + finance only. Cost = hours×rate +
    // council fees; profit = client charge − cost. Council fees are a
    // pass-through expense to T&S, so they belong in cost.
    const hourlyRate = parseFloat((systemConfig && systemConfig.internal_hourly_rate) || 40) || 40;
    const totalLabourCost = totalHours * hourlyRate;
    const totalCost = totalLabourCost + totalCouncilFee;
    const totalProfit = totalCharge - totalCost;
  %>
    <!-- Sub-plan grid (edit only) -->
    <div class="bg-white border border-gray-200 rounded-xl shadow-sm p-6">
      <div class="flex items-center justify-between mb-4">
        <div>
          <h2 class="text-lg font-semibold text-gray-900">Sub-plans</h2>
          <p class="text-sm text-gray-500">Each sub-plan becomes "submitted" the moment you upload its files. Use the buttons after that to approve or reject.</p>
        </div>
      </div>

      <% if (subPlans && subPlans.length > 0) { %>
        <!-- Plan totals strip — rolls up hours and money across all sub-plans.
             Cost + profit tiles only render for admin/finance (canSeeCost). -->
        <div class="grid grid-cols-2 <%= canSeeCost ? 'sm:grid-cols-3 lg:grid-cols-6' : 'sm:grid-cols-4' %> gap-3 mb-5 p-4 bg-gradient-to-br from-brand-50 to-blue-50 border border-brand-100 rounded-lg">
          <div>
            <div class="text-[10px] uppercase tracking-wide text-gray-500 font-semibold">Sub-plans</div>
            <div class="text-lg font-bold text-gray-900 mt-0.5"><%= submittedCount %> / <%= subPlans.length %> <span class="text-xs font-normal text-gray-500">submitted</span></div>
          </div>
          <div>
            <div class="text-[10px] uppercase tracking-wide text-gray-500 font-semibold">Total hours</div>
            <div class="text-lg font-bold text-gray-900 mt-0.5"><%= fmtHours(totalHours) %></div>
          </div>
          <div>
            <div class="text-[10px] uppercase tracking-wide text-gray-500 font-semibold">To charge client</div>
            <div class="text-lg font-bold text-emerald-700 mt-0.5"><%= fmtMoney(totalCharge) %></div>
          </div>
          <div>
            <div class="text-[10px] uppercase tracking-wide text-gray-500 font-semibold">Council fees</div>
            <div class="text-lg font-bold text-amber-700 mt-0.5"><%= fmtMoney(totalCouncilFee) %></div>
          </div>
          <% if (canSeeCost) { %>
            <div title="Hours × $<%= hourlyRate %>/hr + council fees">
              <div class="text-[10px] uppercase tracking-wide text-gray-500 font-semibold flex items-center gap-1">
                T&amp;S cost
                <svg class="w-3 h-3 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m0 0v.01M12 12a3 3 0 100-6 3 3 0 000 6z"/></svg>
              </div>
              <div class="text-lg font-bold text-gray-900 mt-0.5"><%= fmtMoney(totalCost) %></div>
              <div class="text-[10px] text-gray-500 leading-tight">labour <%= fmtMoney(totalLabourCost) %></div>
            </div>
            <div>
              <div class="text-[10px] uppercase tracking-wide text-gray-500 font-semibold">Profit / Loss</div>
              <div class="text-lg font-bold mt-0.5 <%= totalProfit >= 0 ? 'text-emerald-700' : 'text-rose-700' %>">
                <%= (totalProfit >= 0 ? '' : '-') + fmtMoney(Math.abs(totalProfit)) %>
              </div>
              <div class="text-[10px] text-gray-500 leading-tight">
                <% if (totalCharge > 0) { %>
                  margin <%= ((totalProfit / totalCharge) * 100).toFixed(1) %>%
                <% } else { %>
                  no client charge yet
                <% } %>
              </div>
            </div>
          <% } %>
        </div>
        <% if (canSeeCost) { %>
          <div class="mb-5 -mt-3 px-1 text-[11px] text-gray-500 italic">Cost + profit visible to admin &amp; finance only · internal rate $<%= hourlyRate %>/hr</div>
        <% } %>
      <% } %>

      <% if (!subPlans || subPlans.length === 0) { %>
        <div class="text-center py-8 text-sm text-gray-500 bg-gray-50 rounded-lg">No sub-plans yet. Add one below.</div>
      <% } %>

      <% subPlanTypes.forEach(t => { const list = groupedSubPlans[t] || []; %>
        <% if (list.length > 0) { %>
          <div class="mb-6">
            <div class="flex items-center justify-between mb-2">
              <h3 class="text-sm font-semibold text-gray-700"><%= TYPE_LABELS[t] || t %> <span class="text-gray-400">(<%= list.length %>)</span></h3>
              <form method="POST" action="/compliance/<%= item.id %>/sub-plans" class="inline">
                <%- include('../partials/csrf') %>
                <input type="hidden" name="item_type" value="<%= t %>">
                <button type="submit" class="text-xs font-medium text-brand-600 hover:text-brand-700">+ Add another</button>
              </form>
            </div>
            <div class="space-y-3">
              <% list.forEach(sub => { %>
                <%- include('./_sub_plan_card', { sub, docs: (subPlanDocs && subPlanDocs[sub.id]) || [], parentId: item.id, statusBadge: STATUS_BADGE, ra: (typeof raBySubPlan !== 'undefined' && raBySubPlan) ? raBySubPlan[sub.id] : null, fees: (typeof subPlanFees !== 'undefined' && subPlanFees) ? (subPlanFees[sub.id] || []) : [], extensions: (typeof subPlanExtensions !== 'undefined' && subPlanExtensions) ? (subPlanExtensions[sub.id] || []) : [], rolShifts: (typeof subPlanRolShifts !== 'undefined' && subPlanRolShifts) ? (subPlanRolShifts[sub.id] || []) : [], rolConditions: (typeof subPlanRolConditions !== 'undefined' && subPlanRolConditions) ? (subPlanRolConditions[sub.id] || []) : [], rolSubs: rolSubs, tgsSubs: tgsSubs, rolLinks: (typeof subPlanRolLinks !== 'undefined' && subPlanRolLinks) ? (subPlanRolLinks[sub.id] || []) : [], tgsBacklinks: (typeof subPlanTgsBacklinks !== 'undefined' && subPlanTgsBacklinks) ? (subPlanTgsBacklinks[sub.id] || []) : [] }) %>
              <% }) %>
            </div>
          </div>
        <% } %>
      <% }) %>

      <script>
        // "Charge client" / "Council fee" toggles enable their matching
        // amount input — same pattern as the create-page count grid.
        document.querySelectorAll('.charge-toggle').forEach(cb => {
          cb.addEventListener('change', e => {
            const target = document.getElementById(cb.dataset.target);
            if (!target) return;
            target.disabled = !cb.checked;
            if (cb.checked) target.focus();
          });
        });

        // Inline auto-save for sub-plan description / owner / ROL extension.
        // Previously these forms used native submit() on blur/change which
        // caused a full page reload — wiping any half-typed comment or
        // selected upload in the sibling Upload & Submit form on the same
        // card. Now they POST via fetch and stay on the page. The routes
        // already short-circuit to JSON when Accept: application/json.
        // Attach-only forms auto-submit the moment files land (drop OR
        // browse — dropzone.js dispatches a bubbling `change` for both).
        // dropzone.js REPLACES input.files on every drop, so waiting for a
        // manual submit would silently lose earlier batches; submitting per
        // drop loses nothing. Native multipart POST → CSRF-exempt.
        document.querySelectorAll('form[data-attach-form]').forEach(function (f) {
          var input = f.querySelector('input[type="file"]');
          if (!input) return;
          input.addEventListener('change', function () {
            if (!input.files.length || f.__busy) return;
            f.__busy = true;
            f.classList.add('opacity-60', 'pointer-events-none');
            var label = f.querySelector('.dropzone-label p');
            if (label) label.textContent = 'Uploading…';
            f.submit();
          });
        });

        window.__subPlanAjaxSave = function (event, form) {
          if (event) event.preventDefault();
          if (!form || form.__saving) return false;
          form.__saving = true;
          form.classList.add('opacity-60');
          const csrf = (form.querySelector('input[name="_csrf"]') || {}).value || '';
          // Serialise as application/x-www-form-urlencoded. The app registers
          // only express.urlencoded()/express.json() globally — there is NO
          // multipart parser — so a FormData (multipart) body arrives empty on
          // these routes and the save is silently dropped (owner nulled,
          // extension/QA/charge stuck at their defaults). None of these inline
          // forms carry files, so urlencoded is both correct and parseable.
          const body = new URLSearchParams();
          new FormData(form).forEach((v, k) => { body.append(k, v); });
          fetch(form.action, {
            method: 'POST',
            headers: { 'Accept': 'application/json', 'x-csrf-token': csrf },
            body,
            credentials: 'same-origin',
          }).then(r => r.json().catch(() => ({}))).then(data => {
            // Sync defaultValue so subsequent onblur doesn't re-submit the
            // same value. For the ROL extension form, flip the hidden
            // toggle so the next click sends the opposite value.
            form.querySelectorAll('input[type="text"], textarea').forEach(el => { el.defaultValue = el.value; });
            const extHidden = form.querySelector('input[type="hidden"][name="extension_required"]');
            if (extHidden) extHidden.value = (extHidden.value === '1') ? '0' : '1';
            if (data && data.error) console.warn('[sub-plan save]', data.error);
          }).catch(err => {
            console.error('[sub-plan save] failed:', err);
          }).finally(() => {
            form.__saving = false;
            form.classList.remove('opacity-60');
          });
          return false;
        };
      </script>

      <!-- Add a sub-plan of any type -->
      <details class="mt-4 group">
        <summary class="cursor-pointer inline-flex items-center text-sm font-medium text-brand-600 hover:text-brand-700 list-none">
          <svg class="w-4 h-4 mr-1 transition-transform group-open:rotate-45" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
          Add a sub-plan
        </summary>
        <%/* One button per type — no dropdown to work through. Each is its
             own tiny form (mirrors the per-group "+ Add another" pattern).
             "Other" is different: it needs a description, so its button
             reveals a small inline form instead of posting immediately. */%>
        <div class="mt-3 flex flex-wrap gap-1.5">
          <% subPlanTypes.filter(t => t !== 'other').forEach(t => { %>
            <form method="POST" action="/compliance/<%= item.id %>/sub-plans" class="inline">
              <%- include('../partials/csrf') %>
              <input type="hidden" name="item_type" value="<%= t %>">
              <button type="submit" data-quick-add="<%= t %>"
                class="px-2.5 py-1.5 text-xs font-medium text-brand-700 bg-brand-50 hover:bg-brand-100 ring-1 ring-brand-200 rounded-md">
                + <%= TYPE_LABELS[t] || t %>
              </button>
            </form>
          <% }) %>
          <button type="button" id="addOtherToggle" data-quick-add="other"
            class="px-2.5 py-1.5 text-xs font-medium text-gray-700 bg-gray-50 hover:bg-gray-100 ring-1 ring-gray-200 rounded-md">
            + Other…
          </button>
        </div>
        <form method="POST" action="/compliance/<%= item.id %>/sub-plans" class="mt-2 hidden" id="addOtherForm">
          <%- include('../partials/csrf') %>
          <input type="hidden" name="item_type" value="other">
          <div class="flex items-center gap-2">
            <input type="text" name="other_description" maxlength="120" disabled
              placeholder='What is this Other? e.g. "Methodologies", "Staging"'
              class="flex-1 px-3 py-2 bg-white border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-brand-500" />
            <button type="submit" class="px-3 py-2 text-sm font-medium text-white bg-brand-600 hover:bg-brand-700 rounded-lg">Add Other</button>
          </div>
          <p class="mt-1 text-[11px] text-gray-500">Lets you tell several Other rows apart on the register.</p>
        </form>
        <script>
          (function () {
            var toggle = document.getElementById('addOtherToggle');
            var form = document.getElementById('addOtherForm');
            if (!toggle || !form) return;
            var input = form.querySelector('input[name="other_description"]');
            toggle.addEventListener('click', function () {
              var show = form.classList.contains('hidden');
              form.classList.toggle('hidden', !show);
              input.disabled = !show;
              if (show) input.focus();
            });
          })();
        </script>
      </details>
    </div>

    <!-- Bottom-of-page submit row. Buttons sit outside #planForm but
         submit it via the HTML5 form attribute, so the parent fields at
         the top get saved together with whatever the user touched in
         the sub-plan grid. -->
    <div class="mt-6 flex items-center justify-end gap-3">
      <a href="<%= cancelHref %>" class="px-4 py-2 text-sm font-medium text-gray-700 bg-white border border-gray-300 rounded-lg hover:bg-gray-50">Done</a>
      <button type="submit" form="planForm" class="px-4 py-2 text-sm font-medium text-white bg-brand-600 hover:bg-brand-700 rounded-lg">Save &amp; close</button>
    </div>

    <!-- Smart background autosave for the parent plan fields. Edits persist
         on a short debounce (and on blur) without reloading the page; the
         header shows the save state. The server returns JSON for these AJAX
         saves (see POST /compliance/:id parent branch). URL-encoded bodies so
         express.urlencoded parses them — the parent form has no file inputs. -->
    <script>
    (function () {
      var form = document.getElementById('planForm');
      if (!form) return;
      var statusWrap = document.getElementById('plan-autosave-status');
      var statusText = statusWrap && statusWrap.querySelector('[data-autosave-text]');
      var icon = statusWrap && statusWrap.querySelector('svg');
      var cancelHref = <%- JSON.stringify(cancelHref || '/compliance') %>;
      var timer = null, saving = false, pending = false, dirty = false;

      function setStatus(state, msg) {
        if (!statusWrap) return;
        statusWrap.classList.remove('text-gray-400', 'text-amber-600', 'text-red-500', 'text-emerald-600');
        statusWrap.classList.add(state === 'saving' ? 'text-amber-600' : state === 'error' ? 'text-red-500' : state === 'saved' ? 'text-emerald-600' : 'text-gray-400');
        if (statusText) statusText.textContent = msg;
        if (icon) icon.style.display = (state === 'saved' || state === 'idle') ? '' : 'none';
      }

      function params() {
        var p = new URLSearchParams();
        form.querySelectorAll('input[name], select[name], textarea[name]').forEach(function (el) {
          if (el.type === 'checkbox') { if (el.checked) p.append(el.name, el.value || '1'); }
          else if (el.type === 'radio') { if (el.checked) p.append(el.name, el.value); }
          else p.append(el.name, el.value);
        });
        return p;
      }

      function save(opts) {
        opts = opts || {};
        if (saving) { pending = true; return; }
        if (!dirty && !opts.force) { if (opts.then) opts.then(true); return; }
        saving = true; pending = false; dirty = false;
        setStatus('saving', 'Saving…');
        var csrf = (form.querySelector('input[name="_csrf"]') || {}).value || '';
        fetch(form.action, {
          method: 'POST',
          headers: { 'Accept': 'application/json', 'Content-Type': 'application/x-www-form-urlencoded', 'x-csrf-token': csrf },
          body: params().toString(),
          credentials: 'same-origin',
          keepalive: !!opts.keepalive,
        }).then(function (r) { return r.json().catch(function () { return {}; }).then(function (d) { return { ok: r.ok, d: d }; }); })
          .then(function (res) {
            if (res.ok && res.d && res.d.ok) { setStatus('saved', 'All changes saved'); if (opts.then) opts.then(true); }
            else { dirty = true; setStatus('error', 'Save failed — will retry'); if (opts.then) opts.then(false); }
          }).catch(function () { dirty = true; setStatus('error', 'Offline — will retry'); if (opts.then) opts.then(false); })
          .finally(function () { saving = false; if (pending) save(); });
      }

      function queue(delay) { dirty = true; setStatus('saving', 'Saving…'); clearTimeout(timer); timer = setTimeout(function () { save(); }, delay); }

      // Debounce free-text; save discrete controls (select/date/checkbox) quickly.
      form.addEventListener('input', function (e) {
        queue(e.target.matches('textarea, input[type="text"], input[type="search"], input[type="number"]') ? 900 : 250);
      });
      form.addEventListener('change', function () { queue(150); });
      // Flush a pending change as soon as a field loses focus.
      form.addEventListener('focusout', function () { if (timer) { clearTimeout(timer); timer = null; save(); } });
      // Best-effort flush if the user navigates away mid-edit.
      document.addEventListener('visibilitychange', function () { if (document.visibilityState === 'hidden' && (dirty || timer)) { clearTimeout(timer); timer = null; save({ keepalive: true }); } });

      // Explicit "Save & close" — save, then return where they came from.
      form.addEventListener('submit', function (e) {
        e.preventDefault();
        clearTimeout(timer); timer = null;
        save({ force: true, then: function (ok) { if (ok) window.location.href = cancelHref; } });
      });
    })();
    </script>
  <% } %>

  <!-- Address autocomplete + inline quick-creates (both modes). -->
  <script>
  (function () {
    var form = document.getElementById('planForm');
    if (!form) return;
    var csrf = (form.querySelector('input[name="_csrf"]') || {}).value || '';
    var titleInput = form.querySelector('input[name="title"]');
    var addrStatus = document.getElementById('addrStatus');
    var HIDDEN = ['site_address', 'suburb', 'state', 'postcode', 'latitude', 'longitude'];
    function hidden(name) { return form.querySelector('input[type="hidden"][name="' + name + '"]'); }
    function markDirty(el) { el.dispatchEvent(new Event('change', { bubbles: true })); }

    // ── Geoapify autocomplete: body-portaled fixed popover (same device as the
    //    bookings board — ancestor overflow can't clip it). Skips itself
    //    silently when the server reports no API key.
    if (titleInput) {
      var box = document.createElement('div');
      box.style.cssText = 'position:fixed;z-index:9999;background:#fff;border:1px solid #E5E7EB;border-radius:10px;box-shadow:0 12px 30px rgba(0,0,0,.16);max-height:280px;overflow-y:auto;display:none;';
      document.body.appendChild(box);
      var results = [], timer2 = null, disabled = false;

      function placeBox() {
        var r = titleInput.getBoundingClientRect();
        box.style.left = r.left + 'px';
        box.style.top = (r.bottom + 4) + 'px';
        box.style.width = r.width + 'px';
      }
      function hideBox() { box.style.display = 'none'; }
      function renderBox() {
        if (!results.length) { hideBox(); return; }
        box.innerHTML = results.map(function (p, i) {
          return '<button type="button" data-addr-idx="' + i + '" style="display:block;width:100%;text-align:left;padding:9px 13px;border:0;background:none;cursor:pointer;font-family:inherit;border-bottom:1px solid #F3F4F6;">' +
            '<span style="display:block;font-size:13.5px;font-weight:500;color:#111827;">' + (p.site_address || p.label || '') + '</span>' +
            '<span style="display:block;font-size:11.5px;color:#9CA3AF;margin-top:1px;">' + [p.suburb, p.state, p.postcode].filter(Boolean).join(' · ') + '</span>' +
          '</button>';
        }).join('');
        placeBox();
        box.style.display = 'block';
      }
      function commit(p) {
        titleInput.value = p.formatted || [p.site_address, p.suburb, p.state, p.postcode].filter(Boolean).join(', ');
        HIDDEN.forEach(function (n) {
          var el = hidden(n);
          if (el) el.value = (p[n] == null ? '' : p[n]);
        });
        if (addrStatus) {
          addrStatus.textContent = '✓ Located · ' + [p.suburb, p.state, p.postcode].filter(Boolean).join(' ');
          addrStatus.className = 'mt-1.5 text-xs text-emerald-600 font-medium';
        }
        hideBox();
        markDirty(titleInput); // edit mode: pushes the hidden fields through autosave
      }
      // mousedown beats the input's blur; keep click as a fallback.
      ['mousedown', 'click'].forEach(function (evt) {
        box.addEventListener(evt, function (e) {
          var btn = e.target.closest('[data-addr-idx]');
          if (!btn) return;
          e.preventDefault(); e.stopPropagation();
          if (evt === 'mousedown') commit(results[parseInt(btn.dataset.addrIdx, 10)]);
        });
      });
      titleInput.addEventListener('input', function () {
        // Typing by hand invalidates a previously picked location.
        HIDDEN.forEach(function (n) { var el = hidden(n); if (el) el.value = ''; });
        if (addrStatus) {
          addrStatus.textContent = 'Pick a suggestion to pin the location — or just type any plan name.';
          addrStatus.className = 'mt-1.5 text-xs text-gray-400';
        }
        if (disabled) return;
        clearTimeout(timer2);
        var q = titleInput.value.trim();
        if (q.length < 3) { hideBox(); return; }
        timer2 = setTimeout(function () {
          fetch('/compliance/api/places?q=' + encodeURIComponent(q) + '&cc=au', { headers: { 'Accept': 'application/json' } })
            .then(function (r) { return r.json(); })
            .then(function (data) {
              if (data && data.error) { disabled = true; hideBox(); return; } // no key configured — plain text field
              results = (data && data.results) || [];
              renderBox();
            }).catch(function () { hideBox(); });
        }, 220);
      });
      titleInput.addEventListener('blur', function () { setTimeout(hideBox, 150); });
      window.addEventListener('scroll', hideBox, true);
      window.addEventListener('resize', hideBox);
    }

    // ── Inline quick-creates: Job / Client / Tender / PM invite.
    function panel(kind) { return form.querySelector('[data-qa-panel="' + kind + '"]'); }
    function msg(kind, text, tone) {
      var el = form.querySelector('[data-qa-msg="' + kind + '"]');
      if (!el) return;
      el.textContent = text || '';
      el.className = 'text-[11px] ' + (tone === 'error' ? 'text-red-600 font-medium' : 'text-gray-500');
    }
    function fieldVal(kind, name) {
      var p = panel(kind);
      var el = p && p.querySelector('[data-qa-field="' + name + '"]');
      return el ? el.value.trim() : '';
    }
    function addOption(selectId, value, label) {
      var sel = document.getElementById(selectId);
      if (!sel) return;
      sel.add(new Option(label, value, true, true));
      sel.value = String(value);
      markDirty(sel);
    }
    form.querySelectorAll('[data-qa-toggle]').forEach(function (btn) {
      btn.addEventListener('click', function () {
        var p = panel(btn.dataset.qaToggle);
        if (!p) return;
        p.classList.toggle('hidden');
        if (!p.classList.contains('hidden')) {
          var first = p.querySelector('input');
          // Pre-suggest from the address / title where it makes sense.
          if (btn.dataset.qaToggle === 'job' && first && !first.value) {
            first.value = (hidden('site_address') && hidden('site_address').value) || titleInput.value || '';
          }
          if (btn.dataset.qaToggle === 'tender' && first && !first.value) first.value = titleInput.value || '';
          if (first) first.focus();
        }
      });
    });
    form.querySelectorAll('[data-qa-cancel]').forEach(function (btn) {
      btn.addEventListener('click', function () { var p = panel(btn.dataset.qaCancel); if (p) p.classList.add('hidden'); });
    });
    function post(url, params) {
      var body = new URLSearchParams(params);
      body.append('_csrf', csrf);
      return fetch(url, {
        method: 'POST',
        headers: { 'Accept': 'application/json', 'Content-Type': 'application/x-www-form-urlencoded', 'x-csrf-token': csrf },
        body: body.toString(),
        credentials: 'same-origin',
      }).then(function (r) { return r.json().catch(function () { return { ok: false, error: 'Request failed (' + r.status + ')' }; }); });
    }
    function busy(kind, on) {
      var b = form.querySelector('[data-qa-save="' + kind + '"]');
      if (b) { b.disabled = on; b.classList.toggle('opacity-60', on); }
    }
    var saveActions = {
      job: function () {
        var name = fieldVal('job', 'project_name');
        if (!name) return msg('job', 'Project name is required.', 'error');
        busy('job', true); msg('job', 'Creating…');
        post('/compliance/api/quick-job', {
          project_name: name,
          client_id: (document.getElementById('client_id') || {}).value || '',
          site_address: (hidden('site_address') || {}).value || '',
          suburb: (hidden('suburb') || {}).value || '',
          state: (hidden('state') || {}).value || '',
        }).then(function (d) {
          if (!d.ok) return msg('job', d.error || 'Failed.', 'error');
          addOption('job_id', d.job.id, d.job.job_number + ' — ' + [d.job.project_name, d.job.client !== '—' ? d.job.client : ''].filter(Boolean).join(' · '));
          panel('job').classList.add('hidden');
          msg('job', '');
        }).finally(function () { busy('job', false); });
      },
      client: function () {
        var name = fieldVal('client', 'company_name');
        if (!name) return msg('client', 'Company name is required.', 'error');
        busy('client', true); msg('client', 'Creating…');
        fetch('/clients', {
          method: 'POST',
          headers: { 'Accept': 'application/json', 'Content-Type': 'application/json', 'x-csrf-token': csrf },
          body: JSON.stringify({ company_name: name, _csrf: csrf }),
          credentials: 'same-origin',
        }).then(function (r) { return r.json().catch(function () { return {}; }); }).then(function (d) {
          if (!d.success || !d.client) return msg('client', 'Failed to create client.', 'error');
          addOption('client_id', d.client.id, d.client.company_name);
          panel('client').classList.add('hidden');
          msg('client', '');
        }).catch(function (e) { msg('client', e.message, 'error'); }).finally(function () { busy('client', false); });
      },
      tender: function () {
        var title = fieldVal('tender', 'tender_title');
        if (!title) return msg('tender', 'Tender title is required.', 'error');
        busy('tender', true); msg('tender', 'Creating…');
        post('/tenders/api/quick-create', {
          title: title,
          client_id: (document.getElementById('client_id') || {}).value || '',
          site_address: (hidden('site_address') || {}).value || '',
        }).then(function (d) {
          if (!d.ok) return msg('tender', d.error || 'Failed.', 'error');
          addOption('tender_id', d.tender.id, d.tender.tender_number + ' — ' + d.tender.title);
          panel('tender').classList.add('hidden');
          msg('tender', '');
        }).finally(function () { busy('tender', false); });
      },
      pm: function () {
        var name = fieldVal('pm', 'pm_name');
        var email = fieldVal('pm', 'pm_email');
        if (!name || !email) return msg('pm', 'Name and email are required.', 'error');
        busy('pm', true); msg('pm', 'Sending invite…');
        post('/admin/users/api/quick-invite', {
          full_name: name, email: email,
          role: fieldVal('pm', 'pm_role') || 'planning',
        }).then(function (d) {
          if (!d.ok) return msg('pm', d.error || 'Failed.', 'error');
          addOption('pm_id', d.user.id, d.user.full_name);
          // Also make them pickable as a sub-plan owner everywhere.
          ['defaultOwnerSelect'].forEach(function (id) {
            var sel = document.getElementById(id);
            if (sel) sel.add(new Option(d.user.full_name, d.user.id));
          });
          form.querySelectorAll('select[name^="owner_"]').forEach(function (sel) {
            sel.add(new Option(d.user.full_name, d.user.id));
          });
          panel('pm').classList.add('hidden');
          msg('pm', '');
        }).finally(function () { busy('pm', false); });
      },
    };
    form.querySelectorAll('[data-qa-save]').forEach(function (btn) {
      btn.addEventListener('click', function () { var fn = saveActions[btn.dataset.qaSave]; if (fn) fn(); });
    });
    // Enter inside a quick-add panel triggers its save instead of submitting
    // the whole plan form.
    form.querySelectorAll('[data-qa-panel]').forEach(function (p) {
      p.addEventListener('keydown', function (e) {
        if (e.key !== 'Enter') return;
        e.preventDefault();
        var kind = p.dataset.qaPanel;
        var fn = saveActions[kind];
        if (fn) fn();
      });
    });
  })();
  </script>
</div>
