<!-- Mobile sidebar backdrop -->
<div id="sidebar-backdrop" class="fixed inset-0 bg-gray-950/50 backdrop-blur-sm z-40 hidden lg:hidden" aria-hidden="true"></div>

<%
  const b = typeof sidebarBadges !== 'undefined' ? sidebarBadges : {};
%>

<!-- Sidebar — flat charcoal (no emerald gradient). Emerald is reserved for
     the logo mark and the active nav item only. -->
<aside id="sidebar" class="w-[280px] lg:w-[240px] flex-shrink-0 hidden lg:flex lg:flex-col fixed lg:sticky z-50 inset-y-0 left-0 transform -translate-x-full lg:translate-x-0 transition-transform duration-300 ease-out lg:top-0" style="min-height: 100vh; max-height: 100vh; background:#14171D; border-right:1px solid rgba(255,255,255,0.06)">

  <!-- Mobile sidebar header -->
  <div class="lg:hidden px-5 pt-6 pb-4" style="background:#14171D">
    <div class="flex items-center justify-between mb-4">
      <div class="flex items-center gap-3">
        <img src="/images/ts-logo-white.png" alt="T&amp;S Traffic Control" class="h-7 w-auto sidebar-ts-mark-dark">
        <img src="/images/logo-colour.png" alt="T&amp;S Traffic Control" class="h-7 w-auto sidebar-ts-mark-light">
        <span class="text-white text-[15px] font-medium" style="font-family:'Bricolage Grotesque',Geist,sans-serif;letter-spacing:-0.02em">Control Room</span>
      </div>
      <button id="sidebar-close" class="p-2 text-gray-400 hover:text-white hover:bg-white/5 transition-all active:scale-95" style="border-radius:6px" aria-label="Close menu">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
      </button>
    </div>
    <% if (user) { %>
    <div class="flex items-center gap-3 p-3" style="background:rgba(255,255,255,0.04);border-radius:8px">
      <div class="w-9 h-9 flex items-center justify-center text-xs font-semibold text-white" style="background:#22262F;border-radius:6px">
        <%= user.full_name ? user.full_name.split(' ').map(n => n[0]).join('').toUpperCase().substring(0, 2) : 'U' %>
      </div>
      <div class="flex-1 min-w-0">
        <p class="text-white text-sm font-medium truncate"><%= user.full_name %></p>
        <p class="text-gray-500 text-[11px] font-mono uppercase tracking-wider mt-0.5"><%= user.role %></p>
      </div>
    </div>
    <% } %>
    <!-- Quick action buttons -->
    <div class="flex gap-2 mt-3">
      <a href="/profile" class="flex-1 flex items-center justify-center gap-1.5 px-3 py-2 text-gray-300 text-xs font-medium transition-all active:scale-95" style="background:rgba(255,255,255,0.05);border-radius:6px">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
        Profile
      </a>
      <a href="/notifications" class="flex-1 flex items-center justify-center gap-1.5 px-3 py-2 text-gray-300 text-xs font-medium transition-all active:scale-95" style="background:rgba(255,255,255,0.05);border-radius:6px">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"/></svg>
        Alerts
      </a>
    </div>
  </div>

  <!-- Desktop logo area — T&S mark + "Control Room" label. "Powered by Atomis" sits in the footer. -->
  <a href="/dashboard" class="hidden lg:flex items-center gap-3 px-5 py-4 hover:bg-white/[0.03] transition-colors" style="border-bottom:1px solid rgba(255,255,255,0.06)">
    <img src="/images/ts-logo-white.png" alt="T&amp;S Traffic Control" class="h-8 w-auto sidebar-ts-mark-dark">
    <img src="/images/logo-colour.png" alt="T&amp;S Traffic Control" class="h-8 w-auto sidebar-ts-mark-light">
    <span class="text-white text-[15px] font-medium" style="font-family:'Bricolage Grotesque',Geist,sans-serif;letter-spacing:-0.02em">Control Room</span>
  </a>

  <!-- Scrollable nav area.
       visibility:hidden until the inline restore script (at the bottom of
       this nav) sets scrollTop. Without this the browser briefly paints the
       nav at scrollTop=0 before the script runs — that's the "jump to top
       then snap back" flash on every navigation. -->
  <nav style="visibility:hidden" class="flex-1 overflow-y-auto overscroll-contain py-3 px-3 space-y-0.5 sidebar-nav">

    <!-- Toolbar: nav filter (everyone) + compact customise button (admin).
         The filter is client-side only — see the tools script at the bottom
         of this aside. -->
    <div class="sb-toolbar flex items-center gap-1.5 mb-2">
      <div class="sb-filter relative flex-1 min-w-0">
        <svg class="sb-filter-ico" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="11" cy="11" r="7"/><path stroke-linecap="round" d="M21 21l-4.35-4.35"/></svg>
        <input id="sb-filter" type="text" inputmode="search" enterkeyhint="go" placeholder="Filter menu"
               autocomplete="off" spellcheck="false" aria-label="Filter navigation">
      </div>
      <% if (canAccess(user, 'admin')) { %>
      <div class="sb-edit-bar flex items-center flex-shrink-0" data-sb-editbar>
        <button type="button" id="sb-edit-toggle" class="sb-editbtn" title="Customise menu">
          <svg class="w-3.5 h-3.5 flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg>
          <span id="sb-edit-label" class="sb-editbtn-label">Customise menu</span>
        </button>
      </div>
      <% } %>
    </div>

    <%
      // Registry-driven nav (lib/sidebarNav.js — the single source of truth).
      // Section headers double as the dept-hub links; they keep the
      // .sidebar-link class ON PURPOSE: the customiser pools links by
      // pathname from a.sidebar-link, so hub links survive saved layouts.
      const nav = sidebarNav;
      const ctx = nav.makeCtx(user);
      const cp = typeof currentPage !== 'undefined' ? currentPage : '';
      const ttl = typeof title !== 'undefined' ? title : '';
      // Path fallback: many views set locals.currentPage in the template,
      // which never survives into the layout render — on those pages cp is
      // empty, so match the request path against link hrefs instead. Only
      // consulted when cp is empty, so route-passed pages keep exact rules.
      const cpath = typeof currentPath !== 'undefined' ? currentPath : '';
      const pathHit = (href) => !cp && !!cpath && !!href && (cpath === href || cpath.indexOf(href + '/') === 0);
      // ACTIVE keeps the literal `bg-white/15` token — the customiser's
      // auto-open, the e2e assertions and the CSS hooks all key on it. The
      // visual treatment itself lives in CSS (var-driven fill + text).
      // IDLE deliberately no longer contains that token as a variant —
      // `active:bg-white/15` was what painted the "rail on every row" bug.
      const ACTIVE = 'bg-white/15';
      const IDLE = 'active:opacity-80';
      const isActive = (l) => (l.active || []).includes(cp) || (l.activeWhen && l.activeWhen({ currentPage: cp, title: ttl })) || pathHit(l.href);
      // One badge per link (design review §3.5): the danger queue wins; a
      // muted count only shows when nothing is on fire. Display caps at 99+.
      const badgeFor = (l) => {
        const list = l.badges || [];
        const val = (bd) => bd.value ? bd.value(b) : (b[bd.key] || 0);
        const danger = list.filter(bd => bd.tone === 'danger').map(val).find(v => v > 0);
        if (danger) return { v: danger, cls: 'sidebar-badge-crit' };
        const muted = list.filter(bd => bd.tone !== 'danger').map(val).find(v => v > 0);
        return muted ? { v: muted, cls: 'sidebar-badge-muted' } : null;
      };
      const fmtBadge = (v) => v > 99 ? '99+' : v;
      const renderLink = (l) => { const bd = badgeFor(l); %>
    <a href="<%= l.href %>"<%- l.title && l.title(b) ? ' title="' + l.title(b).replace(/"/g, '&quot;') + '"' : '' %> class="sidebar-link flex items-center gap-2.5 px-2.5 py-[7px] text-[13.5px] font-medium rounded-lg <%= isActive(l) ? ACTIVE : IDLE %>">
      <svg class="w-[18px] h-[18px] flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><%- l.icon %></svg>
      <span class="flex-1"><%= l.label %></span>
      <% if (l.pill) { %><span class="sidebar-pill"><%= l.pill %></span><% } %>
      <% if (bd) { %><span class="sidebar-badge <%= bd.cls %>"><%= fmtBadge(bd.v) %></span><% } %>
    </a>
    <% }; %>

    <% nav.TOP_LINKS.filter(l => nav.linkVisible(ctx, l)).forEach(l => { renderLink(l); }) %>

    <% nav.SECTIONS.forEach(s => {
         const links = s.links.filter(l => nav.linkVisible(ctx, l));
         if (!links.length) return; %>
      <div class="pt-3 mt-2 border-t border-white/10 sidebar-section" data-sb-name="<%= s.label %>">
        <%# Section icons sit in the same 5×5 + mr-3 slot as the child links'
            icons, so labels and icons line up down the whole rail. The mark
            is the section's own (nav registry) — the dept hub page shows the
            same one in its title. %>
        <% if (s.hubHref) { %>
        <a href="<%= s.hubHref %>" class="sidebar-link sb-section-head flex items-center gap-2.5 px-2.5 py-[7px] rounded-lg <%= (cp === s.hubActive || pathHit(s.hubHref)) ? ACTIVE : IDLE %>" title="Open <%= s.label %> home">
          <% if (s.icon) { %><svg class="w-[18px] h-[18px] flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><%- s.icon %></svg><% } %>
          <span class="flex-1"><%= s.label %></span>
          <svg class="sb-hub-arrow w-3.5 h-3.5 flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M7 17L17 7M17 7H8m9 0v9"/></svg>
        </a>
        <% } else { %>
        <p class="sb-plain-head flex items-center gap-2.5 px-2.5 mb-1.5">
          <% if (s.icon) { %><svg class="w-[18px] h-[18px] flex-shrink-0 opacity-70" fill="none" stroke="currentColor" viewBox="0 0 24 24"><%- s.icon %></svg><% } %>
          <span><%= s.label %></span>
        </p>
        <% } %>
      </div>
      <% let lastSub = null;
         links.forEach(l => {
           const sub = l.sub || null;
           if (sub !== lastSub) { lastSub = sub; if (sub) { %>
      <div class="sidebar-section" data-sb-sub><p class="sb-sub-head px-2.5 pt-2 mb-1"><%= sub %></p></div>
      <%   } }
           renderLink(l);
         }); %>
    <% }); %>

    <!-- Bottom spacer for safe area + scroll room -->
    <div class="h-20 lg:h-4" data-sb-spacer></div>
  </nav>
  <!-- Restore sidebar scroll BEFORE the browser paints. The matching save
       handler still lives in app.js (loaded later) — putting just the restore
       here keeps the synchronous fast path tight, and stops the "jump to top
       then snap back" flash on every navigation. -->
  <script>(function(){try{
    var nav = document.querySelector('.sidebar-nav');
    if (!nav) return;
    var saved = sessionStorage.getItem('sidebar-scroll');
    if (saved) nav.scrollTop = parseInt(saved, 10);
    // Reveal only after scrollTop is applied so the browser never paints
    // the nav at its default scroll position.
    nav.style.visibility = '';
  }catch(e){
    var n = document.querySelector('.sidebar-nav');
    if (n) n.style.visibility = '';
  }})();</script>

  <!-- Custom sidebar layout (global): folders, order, renamed tabs. Applied as
       a progressive enhancement — if absent or JS fails, the default
       permission-rendered sidebar above is what shows. -->
  <% var __sl = (typeof systemConfig !== 'undefined' && systemConfig && systemConfig.sidebar_layout) ? String(systemConfig.sidebar_layout) : 'null'; %>
  <script>
    window.__SIDEBAR_LAYOUT__ = <%- __sl.replace(/</g, '\\u003c') %>;
    window.__SIDEBAR_CAN_EDIT__ = <%= canAccess(user, 'admin') ? 'true' : 'false' %>;
  </script>
  <%- include('sidebar-customise') %>

  <!-- Sidebar tools: first-load scroll-to-active, collapsed-folder alert
       rollups, and the nav filter. Runs synchronously AFTER the customiser's
       initial render() so it always sees the final DOM (folders included),
       and before app.js. Classes only — it never touches is-collapsed /
       sb-collapsed or the sbCollapsed store. -->
  <script>(function () { try {
    var sidebar = document.getElementById('sidebar'); if (!sidebar) return;
    var nav = sidebar.querySelector('.sidebar-nav'); if (!nav) return;

    // First load with no saved scroll: centre the active link.
    if (!sessionStorage.getItem('sidebar-scroll')) {
      var act = nav.querySelector('a.sidebar-link[class~="bg-white/15"]');
      if (act) {
        var t = act.getBoundingClientRect().top - nav.getBoundingClientRect().top
                + nav.scrollTop - nav.clientHeight / 2 + act.offsetHeight / 2;
        if (t > 0) nav.scrollTop = t;
      }
    }

    // Collapsed-folder alert rollup: a collapsed folder hiding red counts
    // shows their sum on its head, so collapsing never hides urgency.
    function updateCounts() {
      nav.querySelectorAll('.sb-folder').forEach(function (f) {
        var chip = f.querySelector(':scope > .sb-folder-head .sb-folder-count'); if (!chip) return;
        var n = 0;
        f.querySelectorAll('.sidebar-badge-crit').forEach(function (bd) { n += parseInt(bd.textContent, 10) || 0; });
        chip.textContent = n > 99 ? '99+' : n;
        chip.hidden = !(n > 0 && f.classList.contains('is-collapsed'));
      });
    }
    updateCounts();
    // Registered after the customiser's own toggle listener, so the
    // collapse state has already flipped by the time this runs.
    nav.addEventListener('click', function (e) {
      if (e.target.closest && e.target.closest('.sb-folder-head')) updateCounts();
    });

    // Nav filter. Hide/show via classes; sb-filtering force-opens collapsed
    // folder panels in CSS without touching their stored state.
    var input = document.getElementById('sb-filter');
    function applyFilter() {
      if (!input) return;
      var q = input.value.trim().toLowerCase();
      nav.classList.toggle('sb-filtering', !!q);
      nav.querySelectorAll('a.sidebar-link').forEach(function (a) {
        var lb = a.querySelector('.sb-label') || a.querySelector('span.flex-1');
        var txt = (lb ? lb.textContent : a.textContent).trim().toLowerCase();
        a.classList.toggle('sb-hidden', !!q && txt.indexOf(q) === -1);
      });
      nav.querySelectorAll('.sb-folder').forEach(function (f) {
        f.classList.toggle('sb-nomatch', !!q && !f.querySelector('a.sidebar-link:not(.sb-hidden)'));
      });
      nav.querySelectorAll('.sidebar-section').forEach(function (s) {
        var hub = s.querySelector('a.sidebar-link');
        s.classList.toggle('sb-nomatch', !!q && (!hub || hub.classList.contains('sb-hidden')));
      });
    }
    function clearFilter() { if (input && input.value) { input.value = ''; applyFilter(); } }
    if (input) {
      input.addEventListener('input', applyFilter);
      input.addEventListener('keydown', function (e) {
        if (e.key === 'Escape') { e.preventDefault(); clearFilter(); input.blur(); }
        else if (e.key === 'Enter') {
          e.preventDefault();
          if (!nav.classList.contains('sb-filtering')) return;
          var first = nav.querySelector('a.sidebar-link:not(.sb-hidden)');
          if (first) first.click(); // fires app.js's mobile close handler too
        }
      });
      var et = document.getElementById('sb-edit-toggle');
      if (et) et.addEventListener('click', clearFilter); // no sb-hidden residue in edit mode
    }
    // The customiser re-renders on Done — re-run both passes on its event.
    nav.addEventListener('sb:rendered', function () { updateCounts(); applyFilter(); });
  } catch (e) { if (window.console) console.error('[sidebar-tools]', e); } })();</script>

  <!-- Mobile sign out — pinned at bottom -->
  <div class="lg:hidden px-4 py-3 border-t border-white/10 bg-brand-950/80 backdrop-blur-sm">
    <a href="/logout" class="flex items-center justify-center gap-2 w-full px-4 py-3 bg-white/10 hover:bg-red-500/80 text-brand-300 hover:text-white text-sm font-medium rounded-xl transition-all active:scale-[0.98]">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/></svg>
      Sign Out
    </a>
  </div>
</aside>
